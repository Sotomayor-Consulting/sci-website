---
// Import SecondaryCTA component for use in this module
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import Icon2 from "@components/ui/icons/Icon.astro";
import Popover from "@components/ui/blocks/Popover.astro";
import { Icon } from "astro-icon/components";

// Define TypeScript type for products.
type Product = {
  name: string;
  description: string;
  price: string;
  cents: string;
  billingFrequency: string;
  features: Array<string>;
  purchaseBtnTitle: string;
  purchaseLink: string;
};

interface Props {
  pricing: {
    title: string;
    subTitle: string;
    badge: string;
    thirdOption: string;
    btnText: string;
    linkServicios: string;
    starterKit: Product;
    professionalToolbox: Product & { bussines: string[] };
    planestandar: Product & { label: string };
    planUpgrade: {
      title: string;
      description: string;
      price: string;
      cents: string;
      billing: string;
      lista: string[];
      button: string;
      button2: string;
      link: string;
      link2: string;
      popoverTitle: string;
      popoverDescription: string;
    };
  };
}

const { pricing } = Astro.props;
---

<section
  class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  id="precios"
>
  <!-- Section heading and sub-heading -->
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2
      class="text-primario-black text-2xl font-bold tracking-tight text-balance md:text-4xl md:leading-tight dark:text-neutral-200"
    >
      {pricing.title}
    </h2>
    <p class="text-primario-black mt-1 text-pretty dark:text-neutral-400">
      {pricing.subTitle}
    </p>
  </div>
  <!-- Contains two main product blocks -->
  <div class="grid w-full place-items-center gap-4 sm:gap-0 lg:flex">
    <!-- Starter Kit product details -->
    <div
      class="w-full rounded-xl bg-[#262626] p-6 sm:p-8 md:w-1/2 lg:w-1/3 lg:rounded-r-none"
    >
      <div class="mb-4">
        <h3 class="text-2xl font-bold text-neutral-100 sm:text-3xl">
          {pricing.starterKit.name}
        </h3>
        <p class="text-indigo-300">{pricing.starterKit.description}</p>
      </div>
      <div class="mb-4">
        <span class="text-4xl font-bold text-neutral-200"
          >{pricing.starterKit.price}</span
        >
        <span class="text-lg font-bold text-neutral-300"
          >{pricing.starterKit.cents}</span
        >
        <span class="ms-3 text-sm text-indigo-200"
          >{pricing.starterKit.billingFrequency}</span
        >
      </div>
      <!-- Features list - automatically created by mapping over `features` array -->
      <ul class="mb-6 space-y-2 text-neutral-300">
        {
          pricing.starterKit.features.map((feature: string) => (
            <li class="ml-0 flex items-center gap-1.5 lg:ml-5">
              <Icon2 name="checkCircle" />
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
      <!-- CTA for purchasing the product -->
      <a
        href={pricing.starterKit.purchaseLink}
        class="block w-full cursor-pointer rounded-lg bg-gray-500 px-8 py-3 text-center text-sm font-bold text-gray-100 ring-indigo-300 outline-hidden transition duration-100 hover:cursor-pointer hover:bg-gray-600 focus-visible:ring-3 active:text-gray-300 md:text-base"
        >{pricing.starterKit.purchaseBtnTitle}</a
      >
    </div>
    <!-- Professional Toolbox product details -->
    <div
      class="w-full rounded-xl bg-linear-to-tr from-[#12334a] to-[#F09819] p-6 shadow-xl sm:w-1/2 sm:p-8"
    >
      <div
        class="mb-4 flex flex-col items-start justify-between gap-4 lg:flex-row"
      >
        <div>
          <h3 class="text-2xl font-bold text-neutral-100 sm:text-3xl">
            {pricing.professionalToolbox.name}
          </h3>
          <p class="text-orange-200">
            {pricing.professionalToolbox.description}
          </p>
        </div>

        <span
          class="bg-opacity-50 order-first inline-block animate-pulse rounded-full bg-orange-200/60 px-3 py-1 text-center text-xs font-bold tracking-wider text-orange-600 uppercase lg:order-0"
          >{pricing.badge}</span
        >
      </div>

      <div class="mb-4">
        <span class="text-6xl font-bold text-neutral-100"
          >{pricing.professionalToolbox.price}</span
        >
        <span class="text-lg font-bold text-orange-100"
          >{pricing.professionalToolbox.cents}</span
        >
        <span class="ms-3 text-orange-200"
          >{pricing.professionalToolbox.billingFrequency}</span
        >
      </div>
      <!-- Features list - automatically created by mapping over `features` array -->
      <ul class="mb-6 space-y-2 text-orange-100">
        {
          pricing.professionalToolbox.features.map((feature: string) => (
            <li class="mb-5 flex items-center gap-1.5 text-lg font-bold">
              <span>{feature}</span>
            </li>
          ))
        }
        {
          pricing.professionalToolbox.bussines.map((r: string) => (
            <li class="ml-0 flex items-center gap-1.5 text-lg lg:ml-10">
              <Icon2 name="estrella" />
              <span>{r}</span>
            </li>
          ))
        }
      </ul>
      <!-- CTA for purchasing the product -->
      <a
        href={pricing.professionalToolbox.purchaseLink}
        class="bg-opacity-50 hover:bg-secundario active:bg-secundario block w-full cursor-pointer rounded-lg bg-orange-200/40 px-8 py-3 text-center text-sm font-bold text-neutral-100 ring-orange-300 outline-hidden transition duration-300 hover:cursor-pointer focus-visible:ring-3 md:text-base"
        >{pricing.professionalToolbox.purchaseBtnTitle}</a
      >
    </div>
    <!-- Plan standar -->
    <div
      class="w-full rounded-xl bg-[#262626] p-6 sm:w-1/2 sm:p-8 lg:w-1/3 lg:rounded-l-none"
    >
      <div class="mb-4">
        <h3 class="text-2xl font-bold text-neutral-100 sm:text-3xl">
          {pricing.planestandar.name}
        </h3>
        <p class="text-indigo-300">{pricing.planestandar.description}</p>
      </div>

      <div class="mb-4">
        <span class="text-4xl font-bold text-neutral-200"
          >{pricing.planestandar.price}</span
        >
        <span class="text-lg font-bold text-neutral-300"
          >{pricing.planestandar.cents}</span
        >
        <span class="ms-3 text-sm text-indigo-200"
          >{pricing.planestandar.billingFrequency}</span
        >
      </div>
      <!-- Features list - automatically created by mapping over `features` array -->
      <ul class="mb-6 space-y-2 text-neutral-300">
        <li class="mb-5 flex items-center gap-1.5 text-lg">
          <Icon2 name="toolbox" />
          <span class="font-bold">{pricing.planestandar.label}</span>
        </li>
        {
          pricing.planestandar.features.map((feature: string) => (
            <li class="ml-0 flex items-center gap-1.5 lg:ml-5">
              <Icon2 name="checkCircle" />
              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
      <!-- CTA for purchasing the product -->
      <a
        href={pricing.planestandar.purchaseLink}
        class="block w-full cursor-pointer rounded-lg bg-gray-500 px-8 py-3 text-center text-sm font-bold text-gray-100 ring-indigo-300 outline-hidden transition duration-100 hover:cursor-pointer hover:bg-gray-600 focus-visible:ring-3 active:text-gray-300 md:text-base"
        >{pricing.planestandar.purchaseBtnTitle}</a
      >
    </div>
  </div>
  <div class="mt-4 flex w-full justify-center md:mt-10">
    <div
      class="w-full rounded-xl bg-linear-to-tr from-[#F09819] to-[#12334a] p-6 shadow-xl sm:w-1/2 sm:p-8"
    >
      <div
        class="mb-4 flex flex-col items-start justify-between gap-4 lg:flex-row"
      >
        <div class="flex flex-col items-end">
          <Popover title={pricing.planUpgrade.popoverTitle} description={pricing.planUpgrade.popoverDescription} />
          <div class="flex flex-col items-center justify-center">
            <div class="flex justify-center items-center gap-3">
              <h3
                class="text-2xl font-bold text-neutral-100 sm:text-3xl md:text-center"
              >
                {pricing.planUpgrade.title}
              </h3>
              <Icon
                name="mingcute:rocket-line"
                class="text-2xl text-white sm:text-3xl"
              />
            </div>

            <p class="text-white md:text-center">
              {pricing.planUpgrade.description}
            </p>
          </div>
        </div>
      </div>

      <div class="mb-4">
        <span class="text-6xl font-bold text-neutral-100"
          >{pricing.planUpgrade.price}</span
        >
        <span class="text-lg font-bold text-orange-100"
          >{pricing.planUpgrade.cents}</span
        >
        <span class="ms-3 text-orange-200">{pricing.planUpgrade.billing}</span>
      </div>
      <!-- Features list - automatically created by mapping over `features` array -->
      <ul class="mb-6 space-y-2 text-orange-100">
        {
          pricing.planUpgrade.lista.map((li) => (
            <li class="flex items-center gap-1.5">
              <Icon2 name="checkCircle" />
              <span>{li}</span>
            </li>
          ))
        }
      </ul>
      <!-- CTA for purchasing the product -->
      <div class="flex w-full gap-3">
        <a
          href={pricing.planUpgrade.link}
          class="bg-opacity-50 hover:bg-secundario active:bg-secundario block w-full rounded-lg bg-orange-200/40 px-8 py-3 text-center text-sm font-bold text-neutral-100 ring-orange-300 outline-hidden transition duration-300 focus-visible:ring-3 md:text-base"
          >{pricing.planUpgrade.button}</a
        >
        <a
          href={pricing.planUpgrade.link2}
          class="bg-opacity-50 active:bg-secundario block w-full rounded-lg bg-gray-500 px-8 py-3 text-center text-sm font-bold text-neutral-100 ring-orange-300 outline-hidden transition duration-300 hover:bg-gray-600 focus-visible:ring-3 md:text-base"
          >{pricing.planUpgrade.button2}</a
        >
      </div>
    </div>
  </div>

  <!-- Call to action for Enterprise Solutions -->
  <div class="mt-8 flex items-center justify-center gap-x-3 md:mt-12">
    <p class="text-primario-black text-sm dark:text-neutral-400">
      {pricing.thirdOption}
    </p>

    <SecondaryCTA title={pricing.btnText} url={pricing.linkServicios} />
  </div>
</section>
