---
import { Icon } from "astro-icon/components";
interface Props {
  title: string;
  button: string;
}
const { title, button } = Astro.props;
import Imagen from "@images/336shots_so.avif";
---

<!-- Hero -->
<div class="relative overflow-hidden" id="evaluacion">
  <div class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h1
        class="block text-3xl font-bold text-primario-black sm:text-4xl md:text-5xl dark:text-white"
      >
        {title}
      </h1>
    </div>
    <div class="mx-auto max-w-4xl text-center">
      <p class="mt-3 text-base text-primario-black dark:text-neutral-400">
        <slot />
      </p>
    </div>
    <div class="relative mx-auto mt-10 max-w-5xl">
      <div
        class="h-96 w-full rounded-xl bg-cover bg-center bg-no-repeat object-cover sm:h-120"
        style={`background-image: url('${Imagen.src}');`}
      >
      </div>

      <div class="absolute inset-0 size-full">
        <div class="flex size-full flex-col items-center justify-center">
          <a
            class="inline-flex items-center gap-x-2 rounded-full border border-neutral-700 bg-neutral-900 px-4 py-3 text-sm font-medium text-white shadow-2xs hover:border-[#f6b41a] hover:bg-neutral-800 hover:text-[#f6b41a] focus:bg-neutral-800 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
            href="https://sotomayorconsulting.com/diagnostico-llc/"
            target="_blank"
          >
            <Icon
              name="ant-design:thunderbolt-filled"
              class="size-4 shrink-0 animate-pulse"
            />

            {button}
          </a>
        </div>
      </div>

      <div
        class="absolute -start-20 bottom-12 -z-1 size-48 rounded-lg bg-linear-to-b from-orange-500 to-white p-px dark:to-neutral-900"
      >
        <div class="size-48 rounded-lg bg-neutral-200 dark:bg-neutral-900">
        </div>
      </div>

      <div
        class="absolute -end-20 -top-12 -z-1 size-48 rounded-full bg-linear-to-t from-[#155dfc] to-[#00d2f2] p-px"
      >
        <div class="size-48 rounded-full bg-neutral-200 dark:bg-neutral-900">
        </div>
      </div>
    </div>
  </div>
</div>
<!-- End Hero -->
