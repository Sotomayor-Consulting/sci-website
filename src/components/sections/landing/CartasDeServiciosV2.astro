const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith("/en");
const isPortuguese = pathname.startsWith("/pr");

const datacards = isEnglish
  ? datacardsEn
  : isPortuguese
    ? datacardsPr
    : datacardsEs;
---

<section
  class="mx-auto max-w-340 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  id="cartas-servicios"
>
  <!-- Title and description -->
  <div class="mx-auto mb-6 w-full space-y-1 text-center sm:w-1/2 lg:w-1/3">
    <h2
      class="text-primario-black text-2xl leading-tight font-bold text-balance sm:text-3xl dark:text-neutral-200"
    >
      {title}
    </h2>
    {
      subTitle && (
        <p class="text-primario-black leading-tight text-pretty dark:text-neutral-400">
          {subTitle}
        </p>
      )
    }
  </div>

  <!-- Carousel -->
  <div
    id="hs-carousel"
    class="relative"
    data-hs-carousel='{"loadingClasses": "opacity-0", "dotsItemClasses": "hs-carousel-active:bg-secundario hs-carousel-active:border-secundario size-3 border border-line-4 rounded-2xl cursor-pointer border-secundario w-10", "isAutoPlay": true, "isInfiniteLoop": true}'
  >
    <div class="hs-carousel relative lg:min-h-140 md:min-h-140 sm:min-h-140 min-h-100 w-full overflow-hidden">
      <!-- Carousel Body -->
      <div
        class="hs-carousel-body absolute inset-s-0 top-0 bottom-0 flex flex-nowrap opacity-0 transition-transform duration-700"
      >
        {
          datacards.map((data) => {
            // Definimos los títulos de Odoo en cada idioma
            const odooTitles = [
              "Odoo - Software empresarial", // español
              "Odoo - Business Software", // inglés
              "Odoo - Software Empresarial", // portugués (ajusta si es diferente)
            ];

            return odooTitles.includes(data.titulo) ? (
              
              <div class="hs-carousel-slide">
                <div class="flex w-full items-center justify-center">
                  <a
                    class="max-h-4xl h-4xl flex w-2xl flex-col justify-center gap-5 rounded-2xl dark:bg-[#262626] bg-white p-10 hover:scale-103 transition-all duration-300 group"
                    href={data.link}
                  >
                    <Image
                      src={ImagenOdoo}
                      alt="Imagen de ejemplo"
                      class="rounded-xl"
                      height={500}
                      width={1000}
                    />
                    <div class="dark:text-white text-black group-hover:text-[#714B67] dark:group-hover:text-[#714B67] transition-all duration-300 h-20">
                      <h4 class="lg:text-3xl text-xl">{data.titulo}</h4>
                      <p>{data.descripcion}</p>
                    </div>
                    <div class="group/edit flex h-10 w-10 items-center justify-around rounded-full bg-black p-2">
                      <Icon
                        name="mingcute:arrow-right-line"
                        class="h-6 w-6 text-white transition-all duration-110 ease-in group-hover/edit:translate-x-1"
                      />
                    </div>
                  </a>
                </div>
              </div>
            ) : (
              <div class="hs-carousel-slide">
                <div class="flex w-full items-center justify-center">
                  <a
                    class="lg:max-h-4xl lg:h-4xl h-5xl flex w-2xl flex-col justify-center gap-5 rounded-2xl dark:bg-[#262626] bg-white p-10 hover:scale-103 transition-all duration-300 group"
                    href={data.link}
                  >
                    <Image
                      src={data.icono}
                      alt="Imagen de ejemplo"
                      class="rounded-xl"
                      height={500}
                      width={1000}
                      inferSize={true}
                    />
                    <div class="dark:text-white text-black group-hover:text-secundario dark:group-hover:text-secundario transition-all duration-300 h-20">
                      <h4 class="lg:text-3xl text-xl">{data.titulo}</h4>
                      <p>{data.descripcion}</p>
                    </div>
                    <div class="group/edit flex h-10 w-10 items-center justify-around rounded-full bg-black p-2">
                      <Icon
                        name="mingcute:arrow-right-line"
                        class="h-6 w-6 text-white transition-all duration-110 ease-in group-hover/edit:translate-x-1"
                      />
                    </div>
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
      <!-- End Carousel Body -->
    </div>

    <!-- Arrows -->
    <button
      type="button"
      class="hs-carousel-prev hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default text-layer-foreground hover:bg-layer-hover absolute inset-s-2 top-1/2 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-2xs focus:outline-hidden md:inline-flex dark:bg-[#262626]"
    >
      <span class="text-2xl" aria-hidden="true">
        <svg
          class="size-5 shrink-0 stroke-black dark:stroke-white"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
        >
      </span>
      <span class="sr-only">Previous</span>
    </button>
    <button
      type="button"
      class="hs-carousel-next hs-carousel-disabled:opacity-50 hs-carousel-disabled:cursor-default bg-layer text-layer-foreground hover:bg-layer-hover absolute inset-e-2 top-1/2 hidden size-10 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-2xs focus:outline-hidden md:inline-flex dark:bg-[#262626]"
    >
      <span class="sr-only">Next</span>
      <span class="text-2xl" aria-hidden="true">
        <svg
          class="size-5 shrink-0 stroke-black dark:stroke-white"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
        >
      </span>
    </button>
    <!-- End Arrows -->

    <div
      class="hs-carousel-pagination absolute inset-s-0 inset-e-0 -bottom-5 flex justify-center gap-x-2"
    >
    </div>
    <!-- End Pagination -->
  </div>
  <!-- End Carousel -->
</section>

