            id="informe-title"
            class="font-display text-3xl leading-tight text-white sm:text-4xl"
          >
            Tu Informe de Planificación y Diseño de LLC.
          </h2>
        </CardTitle>
      </CardHeader>
      <CardContent class="px-6 pb-8 sm:px-10 sm:pb-10">
        <ul class="grid gap-4 md:grid-cols-3">
          {
            planningDeliverables.map((deliverable) => (
              <li class="flex gap-3 rounded-xl border border-white/10 bg-black/20 p-4 text-sm leading-6 text-white/80 sm:text-base">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-[#ff2525] text-white">
                  <Check class="size-3.5" aria-hidden="true" />
                </span>
                <span>{deliverable}</span>
