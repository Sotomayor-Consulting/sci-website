        </ul>
      </CardContent>
    </Card>
  </section>

  <section
    id="experiencia"
    aria-labelledby="experiencia-title"
    class="relative z-10 bg-black/30 px-4 py-16 sm:px-8 sm:py-20"
  >
    <div class="mx-auto max-w-6xl text-center">
      <p class="mb-3 text-xs font-bold tracking-[0.18em] text-[#ff2525] uppercase">
        Experiencia comprobada
      </p>
      <h2
        id="experiencia-title"
        class="font-display mx-auto max-w-4xl text-3xl leading-tight text-white sm:text-4xl lg:text-5xl"
      >
        <span
          data-fomo-counter
          data-counter-key="black-friday"
          data-count-start="60"
          data-count-max="10000"
          class="mr-2 inline-block tabular-nums"
        >1</span>LLC planificadas e incorporadas por Black Friday.
      </h2>
      <p class="mt-6 text-lg font-semibold text-white/65 sm:text-xl">
        +5.000 empresas acompañadas <span class="mx-2 text-[#ff2525]">·</span>
        10 años de experiencia
      </p>
    </div>
  </section>

  <section
    aria-labelledby="cierre-title"
    class="relative z-10 px-4 py-16 sm:px-8 sm:py-20 lg:py-24"
  >
    <Card
      class="mx-auto max-w-6xl overflow-hidden border-white/10 bg-black text-center text-white ring-white/10"
    >
      <CardContent class="flex flex-col items-center px-6 py-12 sm:px-10 sm:py-16">
        <h2
          id="cierre-title"
          class="font-display max-w-4xl text-3xl leading-tight text-white sm:text-4xl lg:text-5xl"
        >
          Tu LLC empieza bien o empieza a costarte más.
        </h2>
        <h3 class="mt-4 text-xl font-semibold text-white/70 sm:text-2xl">
          Diseña primero. Incorpora después.
        </h3>
        <Button
          as="a"
          href="#agendar"
          variant="primary"
          size="lg"
          class="mt-8 rounded-xl bg-[#ff2525] px-7 font-bold text-white hover:bg-[#e51f1f]"
        >
          Agenda tu reunión
        </Button>
      </CardContent>
    </Card>
  </section>




  <div class="relative z-10 my-10 bg-black/10 py-20">
    <Insight1
      label="Cómo funciona"
      title="De la duda a un plan concreto en tres pasos."
      Cta="Agendar mi asesoría"
      CtaLink="#agendar"
      CtaLabels="60 min · por Zoom · sin compromiso"
      steps={steps1}
    />
  </div>

  <Timeline />

  <div class="relative z-10 my-10 py-20">
    <Insight2
      id="estados"
      label="Elige tu estado ideal"
      title="Delaware, Wyoming o Florida. No todos los estados son iguales para una incorporación."
      description="Recibe la consultoría de un equipo experto y define el estado que corresponde a tu operación antes de incorporar tu LLC, sin errores. Diez años estructurando compañías en Estados Unidos para clientes de toda América Latina."
      Cta="Evalúa tu estado sin costo"
      CtaLink="#agendar"
      CtaLabels="60 min · por Zoom · sin compromiso"
      CtaAdvice="Las tasas estatales las cobra cada estado y se pagan por separado."
      steps={steps2}
    />
  </div>

  <div class="relative z-10 my-10 bg-black/10 py-20">
    <Insight2
      id="servicio"
      label="Consultoría para tu LLC"
      title="Analizamos tu caso y tu actividad antes de recomendarte una estructura."
      description="Una sesión de 60 minutos por Zoom, sin costo y sin compromiso, con un asesor del estudio. Diez años de experiencia en estructuras internacionales."
      Cta="Agenda una llamada sin costo"
      CtaLink="#agendar"
      CtaLabels="100% remoto y en español"
      steps={steps3}
    />
  </div>

  <div class="relative z-10 my-10 py-20">
    <Pricing
      id="precios"
      heading="Valores únicos. Las tasas del Estado se pagan aparte y las cobra el Estado."
      description="El plan ideal según tu caso lo definimos en la primera asesoría."
      plans={planes}
    />
  </div>

  <div class="relative z-10 my-10 py-20">
    <Faq
      id="preguntas"
      label="Preguntas frecuentes"
      title="Lo que debes saber antes de empezar."
      description="Si tu duda no aparece, la resolvemos durante la asesoría."
      faqs={faqs}
      Cta="Resuleve tus dudas en la asesoría"
      CtaLink="#agendar"
      CtaLabels="60 min · por Zoom · sin compromiso"
    />
  </div>
</main>

<script>
  const scope = document.querySelector<HTMLElement>("[data-llc-onboarding-b]");
  const form = scope?.querySelector<HTMLFormElement>("#onboarding-form-b");

  if (scope && form) {
    const activeForm = form;
    const activityInput = form.querySelector<HTMLInputElement>("#activity-b");
    const activityHint = form.querySelector<HTMLElement>("#activity-hint-b");
    const continueToContact = form.querySelector<HTMLButtonElement>(
      "#continue-to-contact-b",
    );
    const continueToSchedule = form.querySelector<HTMLButtonElement>(
      "#continue-to-schedule-b",
    );
    const contactTitle = form.querySelector<HTMLElement>("#contact-title-b");
    const calendarRoot = form.querySelector<HTMLElement>(
      "[data-calendar-paso]",
    );
    let trackingId = "";
    let trackingSent = false;

    if (continueToContact) continueToContact.disabled = true;

    function showStep(step: number) {
      activeForm
        .querySelectorAll<HTMLElement>(".onboarding-step-b")
        .forEach((panel) => {
          panel.classList.toggle("hidden", Number(panel.dataset.step) !== step);
        });

      activeForm
        .querySelectorAll<HTMLElement>("[data-step-indicator]")
        .forEach((indicator) => {
          const indicatorStep = Number(indicator.dataset.stepIndicator);
          const isCurrent = indicatorStep === step;
          const isDone = indicatorStep < step;
          indicator
            .querySelector(".step-number-b")
            ?.classList.toggle("step-active-b", isCurrent);
          indicator
            .querySelector(".step-label-b")
            ?.classList.toggle("step-label-active-b", isCurrent);
          indicator
            .querySelector(".step-value-b")
            ?.classList.toggle("hidden", isDone);
          indicator
            .querySelector(".step-check-b")
            ?.classList.toggle("hidden", !isDone);
          indicator
            .querySelector(".step-number-b")
            ?.classList.toggle("step-done-b", isDone);
        });

      activeForm
        .querySelectorAll<HTMLElement>("[data-line]")
        .forEach((line) => {
          line.classList.toggle(
            "step-line-active-b",
            Number(line.dataset.line) < step,
          );
        });

      const headingSelector =
        step === 2
          ? "#contact-title-b"
          : step === 3
            ? "#schedule-title-b"
            : null;
      if (headingSelector) {
        activeForm
          .querySelector<HTMLElement>(headingSelector)
          ?.focus({ preventScroll: true });
      }

      const panel = activeForm.closest<HTMLElement>("[data-sw-card]");
      if (panel) panel.scrollTop = 0;
    }

    function validateContactFields() {
      const fields = ["#full-name-b", "#email-b", "#phone-b", "#question-b"]
        .map((selector) =>
          activeForm.querySelector<HTMLInputElement | HTMLTextAreaElement>(
            selector,
          ),
        )
        .filter((field): field is HTMLInputElement | HTMLTextAreaElement =>
          Boolean(field),
        );
      const invalidField = fields.find((field) => !field.checkValidity());
      if (!invalidField) return true;
      invalidField.reportValidity();
      invalidField.focus();
      return false;
    }

    function getTrackingId() {
      if (trackingId) return trackingId;
      if (typeof globalThis.crypto?.randomUUID === "function") {
        trackingId = globalThis.crypto.randomUUID();
        return trackingId;
      }
      trackingId = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(
        /[xy]/g,
        (character) => {
          const random = Math.floor(Math.random() * 16);
          const value = character === "x" ? random : (random & 0x3) | 0x8;
          return value.toString(16);
        },
      );
      return trackingId;
    }

    function trackScheduleSelection(currentTrackingId: string) {
      if (trackingSent) return;
      try {
        const uuidPattern =
          /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

        if (!uuidPattern.test(currentTrackingId)) return;
        trackingSent = true;

        const trackingWindow = window as Window & {
          dataLayer?: Array<Record<string, unknown>>;
          SCITikTokRUKarlaQueue?: Array<{
            type: string;
            id: string;
          }>;
        };

        trackingWindow.dataLayer = trackingWindow.dataLayer || [];
        trackingWindow.dataLayer.push({
          event: "lead_datos_completados",
          submission_id: currentTrackingId,
        });
        trackingWindow.dataLayer.push({
          event: "elegir_horario",
          submission_id: currentTrackingId,
        });

        trackingWindow.SCITikTokRUKarlaQueue =
          trackingWindow.SCITikTokRUKarlaQueue || [];
        trackingWindow.SCITikTokRUKarlaQueue.push({
          type: "lead",
          id: currentTrackingId,
        });

        window.dispatchEvent(new CustomEvent("sci:tiktok:ru:karla:flush"));
      } catch {
        // Un fallo de medición no debe interrumpir el formulario.
      }
    }

    activeForm
      .querySelectorAll<HTMLButtonElement>(".activity-button-b")
      .forEach((button) => {
        button.addEventListener("click", () => {
          activeForm
            .querySelectorAll<HTMLButtonElement>(".activity-button-b")
            .forEach((option) => {
              const selected = option === button;
              option.setAttribute("aria-pressed", String(selected));
              option
                .querySelector(".activity-check-b")
                ?.classList.toggle("hidden", !selected);
              option
                .querySelector(".activity-check-wrap-b")
                ?.classList.toggle("activity-check-selected-b", selected);
            });
          if (activityInput) activityInput.value = button.dataset.value ?? "";
          if (activityHint) activityHint.textContent = "Actividad seleccionada";
          if (continueToContact) continueToContact.disabled = false;
        });
      });

    continueToContact?.addEventListener("click", () => {
      if (!activityInput?.value) return;
      showStep(2);
    });

    continueToSchedule?.addEventListener("click", () =>
      activeForm.requestSubmit(),
    );

    activeForm
      .querySelectorAll<HTMLButtonElement>(".back-button-b")
      .forEach((button) => {
        button.addEventListener("click", () =>
          showStep(Number(button.dataset.target)),
        );
      });

    activeForm.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!validateContactFields()) {
        showStep(2);
        return;
      }

      const currentTrackingId = getTrackingId();
      trackScheduleSelection(currentTrackingId);

      showStep(3);
      calendarRoot?.dispatchEvent(
        new CustomEvent("calendar:activate", { bubbles: true }),
      );
      scope.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    activeForm.addEventListener("calendar:back", () => {
      showStep(2);
      contactTitle?.focus({ preventScroll: true });
      scope.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    showStep(1);
  }
</script>

