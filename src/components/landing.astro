<FixedBtn />

<script>
  type JsonRecord = Record<string, unknown>;
  type BookingQuestion = {
    id: string;
    label: string;
    type: string;
    required: boolean;
    position: number;
    options: string[];
  };
  type CalendarConfirmDetail = {
    startAt: string;
    endAt?: string;
    dateLabel?: string;
    timeLabel?: string;
    durationMinutes?: number;
  };

  const form1 = document.querySelector<HTMLFormElement>("#lead-form-1");
  const form2 = document.querySelector<HTMLFormElement>("#lead-form-2");
  const formStep1 = document.querySelector<HTMLElement>("#form-step-1");
  const formStep2 = document.querySelector<HTMLElement>("#form-step-2");
  const calendarStep = document.querySelector<HTMLElement>("#calendar-step");
  const calendarRoot = document.querySelector<HTMLElement>(
    "#calendar-step [data-calendar-paso]",
  );
  const formCard = document.querySelector<HTMLElement>("#agendar");
  const contactTitle = document.querySelector<HTMLElement>("#contact-title");
  const backBtn = document.querySelector<HTMLButtonElement>("#back-btn");
  const calendarBackBtn =
    document.querySelector<HTMLButtonElement>("#calendar-back-btn");
  const calendarBackWrap =
    document.querySelector<HTMLElement>("#calendar-back-wrap");
  const greeting = document.querySelector<HTMLElement>("#calendar-greeting");
  const calendarTitle = document.querySelector<HTMLElement>("#calendar-title");
  const error1 = document.querySelector<HTMLElement>("#form-error-1");
  const error1Description = document.querySelector<HTMLElement>(
    "#form-error-1-description",
  );
  const error2 = document.querySelector<HTMLElement>("#form-error-2");
  const error2Description = document.querySelector<HTMLElement>(
    "#form-error-2-description",
  );
  const phoneInput = document.querySelector<HTMLInputElement>("#phone");

  const submissionId = crypto.randomUUID();
  const DIAL_TO_ISO: Record<string, string> = {
    "+593": "EC",
    "+57": "CO",
    "+52": "MX",
    "+51": "PE",
    "+1": "US",
    "+34": "ES",
    "+54": "AR",
  };
  const ANSWER_FIELDS = ["activity", "advice", "question"] as const;
  const STEP1_FIELDS = [
    { field: "activity", message: "Selecciona tu actividad principal." },
    { field: "advice", message: "Selecciona una opción de asesoría." },
    { field: "question", message: "Cuéntanos tu duda principal." },
  ] as const;

  let bookingInFlight = false;
  let bookingQuestionsPromise: Promise<BookingQuestion[]> | null = null;

  const isRecord = (value: unknown): value is JsonRecord =>
    typeof value === "object" && value !== null && !Array.isArray(value);

  const getTrackingWindow = () =>
    window as Window & { dataLayer?: Array<Record<string, unknown>> };

  const getEventTypeSlug = () =>
    calendarRoot?.dataset.eventTypeSlug?.trim() ?? "";

  const getTimeZone = () => {
    try {
      return Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";
    } catch {
      return "UTC";
    }
  };

  function setForm2Error(message: string) {
    if (error2Description) error2Description.textContent = message;
    error2?.classList.remove("hidden");
  }

  function validateStep1(): boolean {
    const data = form1 ? new FormData(form1) : new FormData();
    const missing = STEP1_FIELDS.find(
      ({ field }) => !String(data.get(field) ?? "").trim(),
    );

    if (!missing) {
      error1?.classList.add("hidden");
      return true;
    }

    if (error1Description) error1Description.textContent = missing.message;
    error1?.classList.remove("hidden");

    const target =
      missing.field === "question"
        ? document.querySelector<HTMLElement>("#question")
        : form1?.querySelector<HTMLElement>(
            `[data-name="${missing.field}"] button`,
          );
    target?.focus();

    return false;
  }

  function showStep(
    step: HTMLElement | null | undefined,
    direction: "forward" | "backward" = "forward",
  ) {
    if (formCard) formCard.dataset.stepDirection = direction;
    [formStep1, formStep2, calendarStep].forEach((s) =>
      s?.classList.add("hidden"),
    );
    step?.classList.remove("hidden");
  }

  const loadBookingQuestions = () => {
    if (!bookingQuestionsPromise) {
      bookingQuestionsPromise = (async () => {
        const params = new URLSearchParams();
        const slug = getEventTypeSlug();
        if (slug) params.set("slug", slug);
        const query = params.size > 0 ? `?${params}` : "";
        const response = await fetch(`/api/questions${query}`, {
          headers: { Accept: "application/json" },
        });
        const payload: unknown = await response.json().catch(() => null);

        if (!response.ok) {
          throw new Error(
            isRecord(payload) && typeof payload.error === "string"
              ? payload.error
              : "No fue posible cargar las preguntas del agendamiento.",
          );
        }
        if (!isRecord(payload) || !Array.isArray(payload.items)) {
          throw new Error("Calnode devolvió preguntas inválidas.");
        }

        return payload.items
          .filter(isRecord)
          .map((item, index) => ({
            id: typeof item.id === "string" ? item.id : String(index),
            label: typeof item.label === "string" ? item.label.trim() : "",
            type:
              typeof item.type === "string" ? item.type.toLowerCase() : "text",
            required: item.required === true,
            position:
              typeof item.position === "number" ? item.position : index,
            options: Array.isArray(item.options)
              ? item.options.filter(
                  (option): option is string => typeof option === "string",
                )
              : [],
          }))
          .filter((question) => question.label.length > 0)
          .sort((a, b) => a.position - b.position);
      })().catch((error) => {
        bookingQuestionsPromise = null;
        throw error;
      });
    }

    return bookingQuestionsPromise;
  };

  const buildAnswers = (
    questions: BookingQuestion[],
    data: FormData,
  ) => {
    const answers: { question_id: string; value: string }[] = [];

    questions.forEach((question, index) => {
      const field = ANSWER_FIELDS[index];
      let value = field ? String(data.get(field) ?? "").trim() : "";

      if (question.type === "checkbox") {
        value = value ? "yes" : "no";
      }

      if (question.required && !value) {
        throw new Error(
          `Falta responder «${question.label}». Usa «Volver a mis datos» para completarla.`,
        );
      }

      if (
        question.type === "select" &&
        value &&
        question.options.length > 0 &&
        !question.options.includes(value)
      ) {
        throw new Error(
          `La respuesta de «${question.label}» no coincide con las opciones configuradas en Calnode.`,
        );
      }

      answers.push({ question_id: question.id, value });
    });

    return answers;
  };

  const buildPhonePayload = (data: FormData) => {
    const country = String(data.get("country") ?? "").trim();
    const raw = String(data.get("phone") ?? "").trim();
    if (!raw) return {};

    const digits = raw.replace(/\D/g, "");
    const normalized =
      raw.startsWith("+") || raw.startsWith("00")
        ? `+${raw.replace(/^00/, "").replace(/\D/g, "")}`
        : `${country}${digits.replace(/^0+/, "")}`;

    if (!/^\+[1-9]\d{6,14}$/.test(normalized)) {
      throw new Error(
        "Revisa el teléfono: usa un número válido con su código de país.",
      );
    }

    return {
      attendee_phone: normalized,
      attendee_phone_country: DIAL_TO_ISO[country] ?? "EC",
    };
  };

  const handleBooking = async (event: Event) => {
    if (bookingInFlight) return;
    const detail = (event as CustomEvent<CalendarConfirmDetail>).detail;
    if (!detail || typeof detail.startAt !== "string") return;

    bookingInFlight = true;
    try {
      if (!form1?.checkValidity() || !form2?.checkValidity()) {
        form1?.reportValidity();
        form2?.reportValidity();
        throw new Error("Revisa tus datos antes de confirmar la reserva.");
      }

      const data1 = form1 ? new FormData(form1) : new FormData();
      const data2 = form2 ? new FormData(form2) : new FormData();
      const questions = await loadBookingQuestions();
      const answers = buildAnswers(questions, data1);
      const phonePayload = buildPhonePayload(data2);
      const slug = getEventTypeSlug();

      const response = await fetch("/api/booking", {
        method: "POST",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          ...(slug ? { slug } : {}),
          start_at: detail.startAt,
          name: String(data2.get("name") ?? "").trim(),
          email: String(data2.get("email") ?? "").trim(),
          ...phonePayload,
          timezone: getTimeZone(),
          language: (document.documentElement.lang || "es").split("-")[0],
          idempotencyKey: `${submissionId}:${detail.startAt}`,
          answers,
        }),
      });
      const payload: unknown = await response.json().catch(() => null);

      if (!response.ok) {
        const message =
          response.status === 409
            ? "Ese horario acaba de ocuparse. Actualizamos la disponibilidad; elige otro horario."
            : isRecord(payload) && typeof payload.error === "string"
              ? payload.error
              : isRecord(payload) && typeof payload.message === "string"
                ? payload.message
                : "No fue posible confirmar la reserva.";
        const error = new Error(message) as Error & {
          slotUnavailable?: boolean;
        };
        error.slotUnavailable = response.status === 409;
        throw error;
      }

      if (calendarBackWrap) calendarBackWrap.style.display = "none";
      calendarRoot?.dispatchEvent(
        new CustomEvent("calendar:booking-success", {
          bubbles: true,
          detail: {
            payload,
            dateLabel: detail.dateLabel ?? "",
            timeLabel: detail.timeLabel ?? "",
          },
        }),
      );

      const trackingWindow = getTrackingWindow();
      trackingWindow.dataLayer = trackingWindow.dataLayer || [];
      trackingWindow.dataLayer.push({
        event: "lead_reserva_confirmada",
        event_type: slug || "test-SCI",
      });
    } catch (error) {
      const slotUnavailable =
        isRecord(error) && error.slotUnavailable === true;
      calendarRoot?.dispatchEvent(
        new CustomEvent("calendar:booking-error", {
          bubbles: true,
          detail: {
            message:
              error instanceof Error
                ? error.message
                : "No fue posible confirmar la reserva.",
            slotUnavailable,
          },
        }),
      );
    } finally {
      bookingInFlight = false;
    }
  };

  form1?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!validateStep1()) return;
    if (!form1.checkValidity()) {
      form1.reportValidity();
      if (error1Description)
        error1Description.textContent =
          "Revisa los campos indicados antes de continuar.";
      error1?.classList.remove("hidden");
      return;
    }
    error1?.classList.add("hidden");
    showStep(formStep2);
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
    contactTitle?.focus({ preventScroll: true });
  });

  backBtn?.addEventListener("click", () => {
    showStep(formStep1, "backward");
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  calendarBackBtn?.addEventListener("click", () => {
    showStep(formStep2, "backward");
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
    contactTitle?.focus({ preventScroll: true });
  });

  phoneInput?.addEventListener("input", () => {
    phoneInput.setCustomValidity("");
  });

  calendarRoot?.addEventListener("calendar:confirm", (event) => {
    void handleBooking(event);
  });

  form2?.addEventListener("submit", (event) => {
    event.preventDefault();
    phoneInput?.setCustomValidity("");
    const phoneDigits = String(phoneInput?.value || "").replace(/\D/g, "");
    if (phoneInput?.value && phoneDigits.length < 7) {
      phoneInput.setCustomValidity(
        "Escribe un número de teléfono válido (al menos 7 dígitos).",
      );
    }
    if (!form2.checkValidity()) {
      form2.reportValidity();
      setForm2Error("Revisa los campos indicados antes de continuar.");
      return;
    }
    error2?.classList.add("hidden");
    const data2 = new FormData(form2);
    const name = String(data2.get("name") || "");

    const trackingWindow = getTrackingWindow();
    trackingWindow.dataLayer = trackingWindow.dataLayer || [];
    trackingWindow.dataLayer.push({
      event: "lead_datos_completados",
    });
    try {
      localStorage.setItem("llcLeadSubmissionId", submissionId);
    } catch {
      // The flow must continue when browser storage is unavailable.
    }

    if (greeting)
      greeting.textContent = `${name.split(" ")[0]}, tus datos están listos. Selecciona el día y la hora.`;
    showStep(calendarStep);
    calendarRoot?.dispatchEvent(
      new CustomEvent("calendar:activate", { bubbles: true }),
    );
    document
      .querySelector("#agendar")
      ?.scrollIntoView({ behavior: "smooth", block: "start" });
    calendarTitle?.focus({ preventScroll: true });
  });
</script>
