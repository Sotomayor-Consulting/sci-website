---
import Check from "@tabler/icons/outline/check.svg";
import { Button } from "@/components/starwind/button";
import Lock from "@tabler/icons/outline/lock.svg";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import {
  Field,
  FieldControl,
  FieldError,
  FieldLabel,
} from "@/components/starwind/field";
import { Form } from "@/components/starwind/form";
import {
  NativeSelect,
  NativeSelectOption,
} from "@/components/starwind/native-select";
import { Textarea } from "@/components/starwind/textarea";

interface Props {
  activityGroups: {
    label: string;
    activities: string[];
  }[];
}

const { activityGroups } = Astro.props;
---

<Card
  id="agendar-b"
  size="md"
  class="min-h-screen rounded-none border-0 bg-[#0d2537] p-0 text-white shadow-[-24px_0_60px_-30px_rgba(0,0,0,.8)]"
>
  <CardHeader class="bg-white px-6 py-7 text-center sm:px-11">
    <CardTitle class="font-display text-xl font-bold text-[#0d2537]">
      Agendar Asesoría Gratis
    </CardTitle>
    <CardDescription class="text-sm text-slate-500">
      Tres pasos y queda reservada
    </CardDescription>
  </CardHeader>

  <Form id="onboarding-form-b" novalidate class="gap-0">
    <CardContent class="px-6 py-7 sm:px-11 sm:py-8">
      <ol class="mb-7 flex items-center" aria-label="Progreso de la reserva">
        {
          ["Tu caso", "Tus datos", "Tu horario"].map((label, index) => (
            <li class="contents">
              {index > 0 && (
                <span
                  class="step-line-b mx-2 h-px flex-1 bg-white/15 transition-colors"
                  data-line={index}
                  aria-hidden="true"
                />
              )}
              <span
                class="step-b flex shrink-0 items-center gap-2"
                data-step-indicator={index + 1}
              >
                <span class="step-number-b grid size-6 place-items-center rounded-full border border-white/15 bg-white/8 text-[.7rem] font-semibold text-white/55">
                  <span class="step-value-b">{index + 1}</span>
                  <Check
                    class="step-check-b hidden size-3.5"
                    aria-hidden="true"
                  />
                </span>
                <span class="step-label-b text-xs font-medium text-white/45">
                  {label}
                </span>
              </span>
            </li>
          ))
        }
      </ol>

      <section class="onboarding-step-b" data-step="1">
        <h2 class="font-display text-xl font-semibold">
          ¿Para qué quieres tu LLC?
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-white/55">
          Elige la actividad principal. Con eso preparamos tu asesoría antes de
          la llamada.
        </p>

        <input
          id="activity-b"
          type="hidden"
          name="activity"
          value=""
          required
        />
        <input
          type="hidden"
          name="advice"
          value="Sí, quiero revisar mi caso con un experto"
        />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="onboarding-website-b">Sitio web</label>
          <input
            id="onboarding-website-b"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="mt-5 space-y-5">
          {
            activityGroups.map((group) => (
              <fieldset class="space-y-2.5">
                <legend class="text-primary text-xs font-bold tracking-[.1em] uppercase">
                  {group.label}
                </legend>
                <div class="grid gap-2 sm:grid-cols-2">
                  {group.activities.map((activity) => (
                    <Button
                      type="button"
                      variant="outline"
                      class="activity-button-b aria-pressed:border-primary aria-pressed:bg-primary/15 h-auto min-h-13 justify-between rounded-xl border-white/15 bg-white/5 px-4 py-3 text-left text-sm whitespace-normal text-white hover:border-white/35 hover:bg-white/10 hover:text-white"
                      data-value={activity}
                      aria-pressed="false"
                    >
                      <span>{activity}</span>
                      <span class="activity-check-wrap-b grid size-4.5 shrink-0 place-items-center rounded-full border border-white/25">
                        <Check
                          class="activity-check-b hidden size-3"
                          aria-hidden="true"
                        />
                      </span>
                    </Button>
                  ))}
                </div>
              </fieldset>
            ))
          }
        </div>

        <div class="mt-6">
          <p
            id="activity-hint-b"
            class="mb-2 text-center text-xs text-white/40"
            aria-live="polite"
          >
            Elige una actividad para continuar
          </p>
          <Button
            id="continue-to-contact-b"
            type="button"
            variant="primary"
            size="lg"
            class="w-full rounded-xl font-semibold"
          >
            Continuar
          </Button>
        </div>
      </section>

      <section class="onboarding-step-b hidden" data-step="2">
        <h2
          id="contact-title-b"
          class="font-display text-xl font-semibold"
          tabindex="-1"
        >
          ¿A dónde te enviamos la cita?
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-white/55">
          Te llega el enlace de Zoom y un recordatorio antes de la llamada.
        </p>

        <div class="mt-5 space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <Field name="name" class="gap-2">
              <FieldLabel for="full-name-b" class="text-white/85">
                Nombre completo
              </FieldLabel>
              <FieldControl
                id="full-name-b"
                name="name"
                type="text"
                autocomplete="name"
                minlength="3"
                required
                placeholder="Tu nombre y apellido"
                class="border-white/15 bg-white/5 text-white placeholder:text-white/35"
              />
              <FieldError match="valueMissing"
                >Escribe tu nombre completo.</FieldError
              >
              <FieldError match="tooShort"
                >Escribe al menos tres caracteres.</FieldError
              >
            </Field>
            <Field name="email" class="gap-2">
              <FieldLabel for="email-b" class="text-white/85">
                Correo electrónico
              </FieldLabel>
              <FieldControl
                id="email-b"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="nombre@empresa.com"
                class="border-white/15 bg-white/5 text-white placeholder:text-white/35"
              />
              <FieldError match="valueMissing">Escribe tu correo.</FieldError>
              <FieldError match="typeMismatch"
                >Escribe un correo válido.</FieldError
              >
            </Field>
          </div>

          <div class="grid grid-cols-[7rem_1fr] items-start gap-2">
            <Field class="gap-2">
              <FieldLabel for="country-code-b" class="text-white/85">
                País
              </FieldLabel>
              <NativeSelect
                id="country-code-b"
                name="countryCode"
                class="border-white/15 bg-white/5 text-white"
              >
                <NativeSelectOption value="+593">EC +593</NativeSelectOption>
                <NativeSelectOption value="+52">MX +52</NativeSelectOption>
                <NativeSelectOption value="+57">CO +57</NativeSelectOption>
                <NativeSelectOption value="+54">AR +54</NativeSelectOption>
                <NativeSelectOption value="+34">ES +34</NativeSelectOption>
                <NativeSelectOption value="+1">US +1</NativeSelectOption>
              </NativeSelect>
            </Field>
            <Field name="phone" class="gap-2">
              <FieldLabel for="phone-b" class="text-white/85">
                Teléfono / WhatsApp
              </FieldLabel>
              <FieldControl
                id="phone-b"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                minlength="7"
                maxlength="15"
                pattern="[0-9+\-().\s]+"
                required
                placeholder="099 123 4567"
                class="border-white/15 bg-white/5 text-white placeholder:text-white/35"
              />
              <FieldError match="valueMissing">Escribe tu número.</FieldError>
              <FieldError match="tooShort"
                >Escribe un teléfono válido.</FieldError
              >
              <FieldError match="patternMismatch"
                >Revisa el formato del teléfono.</FieldError
              >
            </Field>
          </div>

          <Field class="gap-2">
            <FieldLabel for="question-b" class="text-white/85">
              ¿Qué duda principal quieres resolver?
              <span class="font-normal text-white/40"> Opcional</span>
            </FieldLabel>
            <Textarea
              id="question-b"
              name="question"
              rows={3}
              placeholder="Ej.: no sé si me conviene Wyoming o Florida, ni qué pasa con mis impuestos aquí."
              class="min-h-20 resize-none border-white/15 bg-white/5 text-white placeholder:text-white/35"
            />
          </Field>
        </div>

        <div class="mt-6 grid grid-cols-[minmax(7rem,32%)_1fr] gap-2.5">
          <Button
            type="button"
            variant="outline"
            class="back-button-b border-white/20 bg-transparent text-white hover:bg-white/10 hover:text-white"
            data-target="1"
          >
            Volver
          </Button>
          <Button
            id="continue-to-schedule-b"
            type="button"
            variant="primary"
            class="rounded-xl font-semibold"
          >
            Elegir horario
          </Button>
        </div>
        <p
          id="form-status-b"
          class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-white/40"
          aria-live="polite"
        >
          <Lock class="size-3" aria-hidden="true" />
          Tus datos se usan solo para gestionar esta asesoría.
        </p>
      </section>

      <section class="onboarding-step-b hidden" data-step="3">
        <h2
          id="schedule-title-b"
          class="font-display text-xl font-semibold"
          tabindex="-1"
        >
          Elige tu horario
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-white/55">
          Selecciona directamente en Zcal el día y la hora que mejor te
          convengan.
        </p>

        <div
          class="mt-5 overflow-hidden rounded-2xl border border-white/10 bg-white"
        >
          <iframe
            id="zcal-frame-b"
            title="Calendario de reserva — Sotomayor Consulting"
            src="about:blank"
            loading="eager"
            allow="clipboard-write; fullscreen"
            class="h-[760px] w-full border-0"></iframe>
        </div>
        <p class="mt-4 text-center text-xs text-white/50">
          ¿No carga el calendario?
          <a
            id="zcal-open-b"
            href="https://zcal.co/t/agendar-asesoria-llc/60-USA"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary font-semibold underline underline-offset-4"
          >
            Ábrelo en una pestaña nueva
          </a>.
        </p>
      </section>
    </CardContent>
  </Form>
</Card>
