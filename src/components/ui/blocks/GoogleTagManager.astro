---
interface Props {
  gtmId?: string;
}

const { gtmId = "GTM-TNRQGDM" } = Astro.props;
const gtmScriptUrl = `https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(gtmId)}`;
---

<!-- Google Tag Manager -->
<script is:inline data-cfasync="false">
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
  window.__SCI_GTM_MODE__ = "direct";
</script>
<script
  is:inline
  data-cfasync="false"
  async
  src={gtmScriptUrl}
></script>
<!-- End Google Tag Manager -->
