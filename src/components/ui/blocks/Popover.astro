---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<details class="price-popover place-self-end">
  <summary aria-label={`Más información sobre ${title}`}>?</summary>
  <div class="price-popover-content" role="note">
    <strong>{title}</strong>
    <p>{description}</p>
  </div>
</details>

<style>
  .price-popover {
    position: relative;
    z-index: 10;
  }

  .price-popover summary {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    cursor: pointer;
    list-style: none;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 9999px;
    color: white;
    font-weight: 700;
  }

  .price-popover summary::-webkit-details-marker {
    display: none;
  }

  .price-popover summary:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .price-popover-content {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(25rem, calc(100vw - 3rem));
    padding: 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.625rem;
    background: white;
    color: #0d2638;
    box-shadow: 0 12px 30px rgb(0 0 0 / 18%);
  }

  .price-popover-content p {
    margin-top: 0.375rem;
    color: #4b5563;
  }
</style>
