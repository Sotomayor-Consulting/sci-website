---
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import { Image } from "astro:assets";
import form8821 from "@images/formulario-8821.jpg";
import formSS4 from "@images/ss4.jpg";
---

<section
  id="timeline-process"
  class="mx-auto grid h-full max-w-340 gap-4 px-4 py-14 sm:px-6 md:items-center md:gap-8 lg:px-8 2xl:max-w-full"
>
  <div
    class="flex w-full flex-col items-center justify-center py-10 text-center"
  >
    <h3
      class="text-primario-black mb-5 text-2xl leading-tight font-bold text-balance sm:text-4xl md:w-1/2 dark:text-neutral-200"
    >
      Nunca ha sido más fácil constituir una empresa en los EE. UU.
    </h3>
    <div>
      <PrimaryCTA title="Comenzar" url="/#precios" />
      <SecondaryCTA
        title="Más Información"
        url="/servicios-empresariales/llcs/"
      />
    </div>
  </div>

  <div>
    <div class="h-full font-sans text-gray-900">
      <div class="relative">
        <!-- Línea vertical contenida dentro del timeline -->
        <div
          class="pointer-events-none absolute inset-y-0 left-1/2 hidden w-0 -translate-x-1/2 lg:block"
        >
          <div
            id="timeline-track"
            class="absolute inset-y-0 z-20 h-full w-px overflow-visible bg-gradient-to-b from-neutral-200 via-neutral-400 to-neutral-50 dark:from-[#171717] dark:via-neutral-400 dark:to-neutral-800"
          >
            <div
              id="progress-line"
              class="from-secundario via-secundario to-secundario/25 absolute inset-x-0 top-0 h-full origin-top scale-y-0 bg-linear-to-b"
            >
            </div>
          </div>
          <div id="timeline-marker" class="sticky top-1/2 z-30 h-0 w-0">
            <div
              id="progress-circle"
              class="bg-secundario absolute top-0 left-1/2 z-10 hidden h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full shadow-lg lg:block"
            >
              <div
                class="bg-secundario absolute inset-0 animate-ping rounded-full opacity-75"
              >
              </div>
            </div>
            <div
              id="progress-label"
              class="text-primario-black absolute top-0 z-10 hidden -translate-y-1/2 text-2xl font-semibold lg:block dark:text-neutral-200"
            >
              Decide las bases
            </div>
          </div>
        </div>

        <!-- SECCIONES DEL TIMELINE -->

        <!-- Sección 1: tarjeta a la izquierda -->
        <section
          class="timeline-section flex min-h-screen items-center opacity-50 transition-opacity duration-300"
          data-title="Decide las bases"
          data-side="left"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="text-center lg:pr-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-3">
                    <h2
                      class="text-primario-black mb-2 text-2xl font-bold dark:text-neutral-200"
                    >
                      Elija un tipo de empresa y un estado.
                    </h2>
                    <p class="text-primario-black dark:text-neutral-400">
                      El primer paso es decidir en qué estado desea constituir
                      su empresa. A continuación, qué tipo de entidad legal
                      prefiere dentro de ese estado. Cada opción tiene sus
                      ventajas y a continuación le ofrecemos información que le
                      ayudará a decidir. La opción más común es una LLC
                      constituida en Delaware.
                    </p>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-primario-black text-lg font-bold dark:text-white"
                        >
                          LLC.
                        </h3>
                        <p
                          class="text-primario-black mt-2 dark:text-neutral-400"
                        >
                          Una sociedad de responsabilidad limitada es una
                          estructura organizativa empresarial en los Estados
                          Unidos que ayuda a los propietarios de negocios a
                          separar sus responsabilidades personales de las
                          responsabilidades comerciales.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-primario-black text-lg font-bold dark:text-white"
                        >
                          C-Corporation.
                        </h3>
                        <p
                          class="text-primario-black mt-2 dark:text-neutral-400"
                        >
                          Una corporación es una entidad independiente a efectos
                          fiscales. Generalmente, las corporaciones pagan
                          impuestos corporativos sobre sus propias ganancias, y
                          sus accionistas pagan impuestos sobre la renta
                          personal sobre el capital que se les distribuye.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-primario-black text-lg font-bold dark:text-white"
                        >
                          Delaware.
                        </h3>
                        <p
                          class="text-primario-black mt-2 dark:text-neutral-400"
                        >
                          El lugar ideal para las startups que buscan
                          financiación de inversores ángeles y firmas de capital
                          riesgo. La mayoría de las empresas de la lista Fortune
                          500 están constituidas en Delaware.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-primario-black text-lg font-bold dark:text-white"
                        >
                          Wyoming.
                        </h3>
                        <p
                          class="text-primario-black mt-2 dark:text-neutral-400"
                        >
                          Un estado excelente para pequeñas empresas privadas.
                          Costos extremadamente bajos, muy manejable y flexible
                          a medida que su empresa crece.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="hidden lg:block"></div>
            </div>
          </div>
        </section>

        <!-- Sección 2: tarjeta a la derecha -->
        <section
          class="timeline-section flex min-h-screen items-center opacity-50 transition-opacity duration-300"
          data-title="Configura los detalles"
          data-side="right"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="hidden lg:block "></div>
              <div class="lg:pl-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 text-center shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-3">
                    <h2
                      class="text-primario-black mb-2 text-2xl font-bold dark:text-neutral-200"
                    >
                      Concéntrese en su negocio. Nosotros nos encargamos de los
                      detalles.
                    </h2>
                    <p class="text-primario-black dark:text-neutral-400">
                      Una vez recibida su información, prepararemos los
                      formularios incluidos y apoyaremos su presentación ante
                      las agencias estatales y federales correspondientes.
                      Daremos seguimiento y le informaremos sobre las novedades;
                      cada autoridad decide la aprobación, emisión y plazo de
                      respuesta, por lo que no existe un tiempo garantizado.
                    </p>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-primario-black text-lg font-bold dark:text-white"
                        >
                          Formulario 8821
                        </h3>
                        <p
                          class="text-primario-black my-2 dark:text-neutral-400"
                        >
                          Al firmar este formulario, autoriza a nuestro equipo
                          especializado en EIN a obtener actualizaciones sobre
                          el estado de su EIN y a recuperar su carta EIN.
                        </p>
                        <!-- Popover -->
                        <div class="hs-tooltip inline-block [--trigger:hover]">
                          <button
                            type="button"
                            class="hs-tooltip-toggle text-primario-black flex items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-semibold shadow-2xs hover:bg-gray-50 focus:bg-gray-50 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
                          >
                            ver más
                            <span
                              class="hs-tooltip-content hs-tooltip-shown:opacity-100 hs-tooltip-shown:visible text-primario-black invisible absolute z-10 inline-block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm opacity-0 shadow-md transition-opacity dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400"
                              role="tooltip"
                            >
                              <Image
                                src={form8821}
                                class="h-auto w-50"
                                alt="formulario 8821"
                              />
                            </span>
                          </button>
                        </div>
                        <!-- End Popover -->
                      </div>
                    </div>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div class="p-4 md:p-5">
                        <h3
                          class="text-primario-black text-lg font-bold dark:text-white"
                        >
                          Formulario SS-4
                        </h3>
                        <p
                          class="text-primario-black my-2 dark:text-neutral-400"
                        >
                          La Solicitud de Número de Identificación Patronal
                          (SS-4) es el formulario del IRS que utilizamos para
                          solicitar un EIN para su nueva empresa.
                        </p>
                        <!-- Popover -->
                        <div class="hs-tooltip inline-block [--trigger:hover]">
                          <button
                            type="button"
                            class="hs-tooltip-toggle text-primario-black flex items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-semibold shadow-2xs hover:bg-gray-50 focus:bg-gray-50 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
                          >
                            ver más
                            <span
                              class="hs-tooltip-content hs-tooltip-shown:opacity-100 hs-tooltip-shown:visible text-primario-black invisible absolute z-10 inline-block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm opacity-0 shadow-md transition-opacity dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400"
                              role="tooltip"
                            >
                              <Image
                                src={formSS4}
                                class="h-auto w-50"
                                alt="formulario 8821"
                              />
                            </span>
                          </button>
                        </div>
                        <!-- End Popover -->
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Sección 3: izquierda -->
        <section
          class="timeline-section flex min-h-screen items-center opacity-50 transition-opacity duration-300"
          data-title="Apertura de cuenta bancaria"
          data-side="left"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="text-center lg:pr-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 shadow-lg dark:bg-[#262626]"
                >
                  <h2
                    class="text-primario-black mb-2 text-2xl font-bold dark:text-neutral-200"
                  >
                    Abre una cuenta con uno de nuestros socios bancarios.
                  </h2>
                  <p class="text-primario-black dark:text-neutral-400">
                    Te orientamos en la preparación de la solicitud ante
                    proveedores de banca digital. Cada proveedor evalúa sus
                    requisitos y decide de forma independiente la apertura, las
                    condiciones y los plazos de la cuenta.
                  </p>
                </div>
              </div>
              <div class="hidden lg:block"></div>
            </div>
          </div>
        </section>

        <!-- Sección 4: derecha -->
        <section
          class="timeline-section flex min-h-screen flex-col items-center opacity-50 transition-opacity duration-300"
          data-title="Da seguimiento a tus solicitudes"
          data-side="right"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="hidden lg:block"></div>
              <div class="lg:pl-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 text-center shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-5">
                    <h2
                      class="text-primario-black mb-2 text-2xl font-bold dark:text-neutral-200"
                    >
                      Te acompañamos en la solicitud de tu número de
                      identificación fiscal ante el IRS.
                    </h2>
                    <p class="text-primario-black dark:text-neutral-400">
                      El Número de Identificación Patronal (EIN) identifica a la
                      empresa para completar sus declaraciones federales y
                      solicitar cuentas bancarias. Preparamos y apoyamos la
                      presentación de la solicitud como proveedor privado; el
                      IRS decide la emisión y el tiempo de procesamiento. En
                      determinados casos, una persona no residente puede
                      solicitar un EIN sin SSN o ITIN, sujeto a los requisitos
                      del IRS.
                    </p>
                  </div>
                  <div class="mb-3 hover:scale-101">
                    <div
                      class="flex flex-col rounded-xl border border-neutral-200 bg-neutral-200 shadow-lg dark:border-neutral-700 dark:bg-neutral-900 dark:shadow-neutral-700/70"
                    >
                      <div
                        class="flex flex-col items-center justify-center p-4 md:p-5"
                      >
                        <img
                          src="https://cdn.prod.website-files.com/609486d2fafa37698a57db5b/61378f6540c42e7d5dd4373b_firstbase-irs.svg"
                          loading="lazy"
                          alt="Servicio de Impuestos Internos (IRS)"
                          class="w-40 invert filter dark:invert-0"
                        />
                        <p
                          class="text-primario-black/60 mt-2 text-2xl dark:text-neutral-400/60"
                        >
                          Número de identificación del empleador
                        </p>
                        <p
                          class="text-primario-black mt-2 text-4xl dark:text-neutral-400"
                        >
                          12-3456789
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="container mx-auto mt-5 px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="hidden lg:block"></div>
              <div class="lg:pl-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 text-center shadow-lg dark:bg-[#262626]"
                >
                  <div class="mb-5">
                    <h2
                      class="text-primario-black mb-2 text-2xl font-bold dark:text-neutral-200"
                    >
                      Preparamos los documentos corporativos privados incluidos.
                    </h2>
                    <p class="text-primario-black dark:text-neutral-400">
                      Tras el registro de la empresa por la autoridad,
                      preparamos el conjunto de documentos corporativos privados
                      incluido en el plan. Estos documentos
                      proporcionan información clara y necesaria sobre los
                      propietarios, las operaciones y otros detalles vitales de
                      la empresa. No sustituyen certificados ni documentos
                      oficiales emitidos por el Estado.
                    </p>
                  </div>
                  <div class="mb-3">
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo operativo
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Certificado de Secretario
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo de compra de acciones
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo de indemnización para accionistas
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Actuación por consentimiento escrito del fundador
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Acuerdo de cesión de tecnología
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Estatutos corporativos
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Resoluciones organizativas iniciales del Consejo de
                        Administración
                      </span>
                    </div>
                    <div class="m-2 hover:scale-101">
                      <span
                        class="text-primario-black inline-flex items-center gap-x-1 rounded-full bg-gray-300 px-2 py-1 text-xs dark:bg-neutral-500/20 dark:text-neutral-400"
                      >
                        Certificado de acciones ordinarias
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!--Sección 5: izquierda 
        <section
          class="timeline-section flex min-h-screen items-center opacity-50 transition-opacity duration-300"
          data-title="Apertura de cuenta bancaria"
          data-side="left"
        >
          <div class="container mx-auto px-6 lg:px-16">
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div class="text-center lg:pr-24">
                <div
                  class="inline-block rounded-2xl bg-white p-8 shadow-lg dark:bg-[#262626]"
                >
                  <h2
                    class="mb-2 text-2xl font-bold text-primario-black dark:text-neutral-200"
                  >
                    Abre una cuenta con uno de nuestros socios bancarios.
                  </h2>
                  <p class="text-primario-black dark:text-neutral-400">
                    Te orientamos en la preparación de la solicitud ante
                    proveedores de banca digital. Cada proveedor evalúa sus
                    requisitos y decide de forma independiente la apertura, las
                    condiciones y los plazos de la cuenta.
                  </p>
                </div>
              </div>
              <div class="hidden lg:block"></div>
            </div>
          </div>
        </section>-->
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initTimeline = () => {
      const root = document.getElementById("timeline-process");

      if (!root || root.dataset.timelineInitialized === "true") return;

      root.dataset.timelineInitialized = "true";

      const track = root.querySelector(
        "#timeline-track",
      ) as HTMLDivElement | null;
      const marker = root.querySelector(
        "#timeline-marker",
      ) as HTMLDivElement | null;
      const progressLine = root.querySelector(
        "#progress-line",
      ) as HTMLDivElement | null;
      const circle = root.querySelector(
        "#progress-circle",
      ) as HTMLDivElement | null;
      const label = root.querySelector(
        "#progress-label",
      ) as HTMLDivElement | null;
      const sections = gsap.utils.toArray<HTMLElement>(".timeline-section");

      if (
        !track ||
        !marker ||
        !progressLine ||
        !circle ||
        !label ||
        sections.length === 0
      )
        return;

      const setLabelPosition = (side: string) => {
        if (side === "right") {
          gsap.set(label, {
            left: "calc(50% - 3rem)",
            xPercent: -100,
            textAlign: "right",
          });
          return;
        }

        gsap.set(label, {
          left: "calc(50% + 3rem)",
          xPercent: 0,
          textAlign: "left",
        });
      };

      const setActiveSection = (activeSection: HTMLElement) => {
        sections.forEach((section) => {
          gsap.to(section, {
            autoAlpha: section === activeSection ? 1 : 0.45,
            duration: 0.35,
            overwrite: "auto",
          });
        });

        const title = activeSection.dataset.title ?? "";
        const side = activeSection.dataset.side ?? "left";

        gsap.to(label, {
          autoAlpha: 0,
          y: -8,
          duration: 0.15,
          overwrite: "auto",
          onComplete: () => {
            label.textContent = title;
            setLabelPosition(side);
            gsap.to(label, {
              autoAlpha: 1,
              y: 0,
              duration: 0.25,
              overwrite: "auto",
            });
          },
        });
      };

      const mm = gsap.matchMedia();

      mm.add("(min-width: 1024px)", () => {
        gsap.set([track, marker, circle, label], { display: "block" });
        gsap.set(progressLine, { scaleY: 0, transformOrigin: "top top" });
        gsap.set(circle, { y: 0 });
        gsap.set(label, { y: 0, autoAlpha: 1 });
        setLabelPosition(sections[0].dataset.side ?? "left");
        setActiveSection(sections[0]);

        const progressTimeline = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: root,
            start: "top center",
            end: "bottom center",
            scrub: 0.35,
            invalidateOnRefresh: true,
          },
        });

        progressTimeline.to(progressLine, { scaleY: 1 }, 0);

        sections.forEach((section) => {
          ScrollTrigger.create({
            trigger: section,
            start: "top center",
            end: "bottom center",
            onEnter: () => setActiveSection(section),
            onEnterBack: () => setActiveSection(section),
          });
        });

        return () => {
          progressTimeline.scrollTrigger?.kill();
          progressTimeline.kill();
        };
      });

      mm.add("(max-width: 1023px)", () => {
        gsap.set([track, marker, circle, label], { display: "none" });
        gsap.set(sections, { clearProps: "opacity,visibility" });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTimeline, {
        once: true,
      });
    } else {
      initTimeline();
    }
  </script>

  <style is:global>
    /* Efecto ping del círculo */
    @keyframes ping {
      75%,
      100% {
        transform: scale(2);
        opacity: 0;
      }
    }
    .animate-ping {
      animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  </style>
</section>
