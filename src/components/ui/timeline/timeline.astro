---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";

import { Icon } from "astro-icon/components";

import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import "@/styles/starwind.css";

const steps = [
  {
    title: "Primera conversación sin costo",
    description:
      "Analizamos tu actividad y tu caso antes de tomar cualquier decisión.",
    icon: "video",
  },
  {
    title: "Diseño de tu estructura",
    description:
      "Definimos el código de actividad, la estructura societaria, la contabilidad y, si aplica, la estructura internacional.",
    icon: "map",
  },
  {
    title: "LLC o C-Corp",
    description:
      "Evaluamos cuál se ajusta mejor a tu caso y ante qué secretario de Estado se presentará la solicitud.",
    icon: "building",
  },
  {
    title: "Tus documentos corporativos",
    description:
      "Revisamos contigo los documentos corporativos privados de la LLC o de la C-Corp.",
    icon: "file",
  },
  {
    title: "Sistema financiero estadounidense",
    description:
      "Te orientamos sobre neobancos, bancos físicos y pasarelas de pago según las necesidades de tu operación.",
    icon: "bank",
  },
  {
    title: "Tax & legal",
    description:
      "Te acompañamos con la planificación tributaria y la preparación de declaraciones de impuestos en Estados Unidos.",
    icon: "calendar",
  },
  {
    title: "Un año de consultas ilimitadas",
    description:
      "Mantienes acceso a tu consultor durante doce meses para resolver dudas sobre tu estructura.",
    icon: "legal",
  },
];
---

<section
  class="timeline-shell bg-background text-foreground relative isolate overflow-hidden rounded-3xl px-4 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24"
  aria-labelledby="consulting-process-title"
>
  <div class="timeline-glow" aria-hidden="true"></div>

  <header class="relative mx-auto max-w-3xl text-center">
    <p class="mb-4 text-xs font-bold tracking-[0.2em] text-primary uppercase">
      Cómo trabajamos
    </p>
    <h1
      id="consulting-process-title"
      class="font-display text-4xl leading-[1.08] font-bold tracking-[-0.04em] text-balance sm:text-5xl lg:text-6xl"
    >
      Consultoría, <span class="text-primary italic">paso a paso</span>
    </h1>
    <p
      class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg"
    >
      Siete etapas. Te acompañamos durante todo el proceso con un servicio
      integral y una ruta clara desde el primer día.
    </p>
  </header>

  <ol class="timeline-route relative mx-auto mt-14 max-w-6xl sm:mt-20">
    <svg
      class="timeline-ribbon"
      viewBox="0 0 400 2464"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <defs>
        <linearGradient id="timeline-gold" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--primary)" stop-opacity="0.12"
          ></stop>
          <stop offset="0.16" stop-color="var(--primary)" stop-opacity="0.9"
          ></stop>
          <stop offset="0.84" stop-color="var(--primary)" stop-opacity="0.9"
          ></stop>
          <stop offset="1" stop-color="var(--primary)" stop-opacity="0.12"
          ></stop>
        </linearGradient>
      </defs>
      <path
        d="M100 176 C100 335 300 369 300 528 C300 687 100 721 100 880 C100 1039 300 1073 300 1232 C300 1391 100 1425 100 1584 C100 1743 300 1777 300 1936 C300 2095 100 2129 100 2288"
        stroke="var(--timeline-track)"
        stroke-width="24"
        stroke-linecap="round"></path>
      <path
        d="M100 176 C100 335 300 369 300 528 C300 687 100 721 100 880 C100 1039 300 1073 300 1232 C300 1391 100 1425 100 1584 C100 1743 300 1777 300 1936 C300 2095 100 2129 100 2288"
        stroke="url(#timeline-gold)"
        stroke-width="5"
        stroke-linecap="round"></path>
    </svg>

    {
      steps.map((step, index) => {
        const StepIcon = step.icon;
        const side = index % 2 === 0 ? "left" : "right";

        return (
          <li class="timeline-step" data-side={side}>
            <span class="timeline-connector" aria-hidden="true" />

            <div class="timeline-node" aria-hidden="true">
              <span class="timeline-node-ring">
                <Icon name={StepIcon} class="size-15" />
              </span>
            </div>

            <Card
              size="md"
              class="timeline-card border-border/70 bg-card/95 shadow-2xl shadow-black/10 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-primary/45"
            >
              <CardHeader class="gap-3">
                <Badge
                  variant="primary"
                  size="sm"
                  class="w-fit tracking-[0.12em] uppercase"
                >
                  Paso {index + 1}
                </Badge>
                <CardTitle class="font-display text-xl font-bold tracking-[-0.025em] sm:text-2xl">
                  {step.title}
                </CardTitle>
                <CardDescription class="leading-relaxed text-muted-foreground">
                  {step.description}
                </CardDescription>
              </CardHeader>
            </Card>
          </li>
        );
      })
    }
  </ol>

  <div class="relative mx-auto mt-16 max-w-3xl text-center sm:mt-20">
    <div class="mx-auto mb-7 h-px w-20 bg-primary/60" aria-hidden="true"></div>
    <p class="text-base leading-relaxed text-foreground/90 sm:text-lg">
      El estado, la estructura y los costos los definimos contigo en la primera
      conversación, sin costo y sin compromiso.
    </p>
    <Button
      href="#agendar"
      variant="primary"
      size="lg"
      class="mt-7 shadow-lg shadow-black/20"
    >
      Agenda tu consultoría gratis
      <ArrowRight />
    </Button>
    <p
      class="mx-auto mt-7 max-w-2xl text-xs leading-relaxed text-muted-foreground"
    >
      SCI es una consultora privada e independiente: no es una agencia
      gubernamental ni está afiliada o respaldada por una. Brindamos
      orientación, preparación documental y acompañamiento; la autoridad o el
      proveedor competente decide la aprobación, emisión y los plazos.
    </p>
  </div>
</section>

<style>
  .timeline-shell {
    --background: #0d2638;
    --foreground: #f8fafc;
    --card: #123247;
    --card-foreground: #f8fafc;
    --muted: #183c52;
    --muted-foreground: #b8c7d2;
    --border: rgb(255 255 255 / 12%);
    --outline: #d9a84e;
    --primary: #d9a84e;
    --primary-foreground: #0a2030;
    --gold: var(--primary);
    --gold-2: #e8c46f;
    --timeline-track: rgb(255 255 255 / 7%);
  }

  .timeline-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at 12% 8%,
        rgb(217 168 78 / 11%),
        transparent 27rem
      ),
      radial-gradient(
        circle at 88% 72%,
        rgb(74 130 162 / 12%),
        transparent 30rem
      ),
      linear-gradient(
        180deg,
        rgb(255 255 255 / 2%),
        transparent 18%,
        transparent 82%,
        rgb(0 0 0 / 12%)
      );
  }

  .timeline-route::before {
    position: absolute;
    top: 5rem;
    bottom: 5rem;
    left: 50%;
    width: 2px;
    content: "";
    background: linear-gradient(
      to bottom,
      transparent,
      var(--primary) 8%,
      var(--primary) 92%,
      transparent
    );
  }

  .timeline-ribbon {
    display: none;
  }

  .timeline-step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    justify-items: center;
  }

  .timeline-step + .timeline-step {
    margin-top: 5rem;
  }

  .timeline-node {
    z-index: 2;
    display: grid;
    grid-column: 1;
    place-items: center;
    width: 8.2rem;
    height: 8.2rem;
    color: var(--primary-foreground);
    background: rgb(13 38 56 / 92%);
    border: 1px solid rgb(217 168 78 / 35%);
    border-radius: 999px;
    box-shadow: 0 0 0 6px rgb(13 38 56 / 92%);
  }

  .timeline-node-ring {
    display: grid;
    place-items: center;
    width: 7rem;
    height: 7rem;
    background: linear-gradient(
      145deg,
      var(--gold-2),
      var(--gold) 52%,
      #b98c38
    );
    border-radius: inherit;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 35%);
  }

  :global(.timeline-card) {
    grid-column: 1;
    width: 100%;
  }

  .timeline-connector {
    display: none;
  }

  @media (min-width: 900px) {
    .timeline-route::before {
      display: none;
    }

    .timeline-ribbon {
      position: absolute;
      inset: 0 auto 0 50%;
      display: block;
      width: 20rem;
      height: 100%;
      transform: translateX(-50%);
    }

    .timeline-step {
      grid-template-columns: minmax(0, 1fr) 11.25rem minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
      justify-items: stretch;
      min-height: 22rem;
    }

    .timeline-step + .timeline-step {
      margin-top: 0;
    }

    .timeline-node {
      grid-column: 2;
      grid-row: 1;
    }

    .timeline-step[data-side="left"] .timeline-node {
      justify-self: start;
    }

    .timeline-step[data-side="right"] .timeline-node {
      justify-self: end;
    }

    .timeline-step[data-side="left"] :global(.timeline-card) {
      grid-column: 1;
      grid-row: 1;
    }

    .timeline-step[data-side="right"] :global(.timeline-card) {
      grid-column: 3;
      grid-row: 1;
    }

    .timeline-connector {
      z-index: 1;
      display: block;
      grid-column: 2;
      grid-row: 1;
      width: calc(50% + 2rem);
      height: 1px;
      background: linear-gradient(90deg, var(--primary), rgb(217 168 78 / 8%));
    }

    .timeline-step[data-side="left"] .timeline-connector {
      justify-self: start;
      transform: translateX(-2rem) rotate(180deg);
      transform-origin: center;
    }

    .timeline-step[data-side="right"] .timeline-connector {
      justify-self: end;
      transform: translateX(2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.timeline-card) {
      transition: none;
    }
  }
</style>
