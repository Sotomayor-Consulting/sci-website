---
import Check from "@tabler/icons/outline/check.svg";
import Lock from "@tabler/icons/outline/lock.svg";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Icon } from "astro-icon/components";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import {
  Field,
  FieldControl,
  FieldError,
  FieldLabel,
} from "@/components/starwind/field";
import { Form } from "@/components/starwind/form";
import {
  NativeSelect,
  NativeSelectOption,
} from "@/components/starwind/native-select";
import { Textarea } from "@/components/starwind/textarea";
// import Icon from "node_modules/astro-icon/components/Icon.astro";

const activityGroups = [
  {
    label: "Operar un negocio",
    activities: [
      "Exportación de servicios profesionales",
      "E-commerce",
      "Trader / compra-venta de productos",
      "Fintech",
    ],
  },
  {
    label: "Invertir o proteger",
    activities: [
      "Invertir en Bolsa de Valores",
      "Trader de Stocks",
      "Negocios en bienes raíces",
      "Proteger mi patrimonio",
    ],
  },
];

const benefits = [
  ["30 minutos", "Por Zoom, sin compromiso"],
  ["Sin visa ni residencia", "Sin SSN ni ITIN"],
  ["100% remoto", "Atención en español"],
];

import HeromImage from "@images/Hero_Sotomayor_3.avif";
---

<main
  class="relative min-h-screen overflow-hidden bg-[#0d2537] text-white"
  data-llc-onboarding-b
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_72%_12%,rgba(216,167,79,.18),transparent_28%),radial-gradient(circle_at_18%_84%,rgba(50,105,137,.34),transparent_35%),linear-gradient(115deg,#081d2c_0%,#0d2a3e_48%,#183f58_100%)]"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 [background-image:linear-gradient(rgba(255,255,255,.06)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.06)_1px,transparent_1px),var(--hero-image)] [background-size:54px_54px,54px_54px,cover] [background-position:0_0,0_0,center] [background-repeat:repeat,repeat,no-repeat] opacity-10"
    style={`--hero-image: url('${HeromImage.src}');`}
  >
  </div>

  <div
    class="relative z-10 grid min-h-screen xl:grid-cols-[minmax(0,1fr)_36.625rem]"
  >
    <section
      class="flex min-h-[40rem] flex-col px-6 py-8 sm:px-10 lg:px-15 lg:py-10 xl:min-h-screen"
      aria-labelledby="llc-b-title"
    >
      <Icon
        name="logo-sotomayor-consulting-black"
        class="h-auto w-46 sm:w-54"
      />

      <!-- <nav
        class="mt-8 flex flex-wrap gap-x-7 gap-y-3 text-sm font-medium text-white/65"
        aria-label="Información del servicio"
      >
        <a class="transition-colors hover:text-white" href="#agendar-b"
          >¿Qué incluye?</a
        >
        <a class="transition-colors hover:text-white" href="#agendar-b"
          >Planes</a
        >
        <a class="transition-colors hover:text-white" href="#agendar-b"
          >Bancos y aliados</a
        >
        <a class="border-b border-primary pb-1 text-primary" href="#agendar-b"
          >Respaldo legal</a
        >
      </nav> -->

      <div class="my-auto max-w-3xl py-14 lg:py-20">
        <Badge
          tone="primary"
          appearance="outline"
          eyebrow
          class="border-primary/55 text-primary mb-5"
        >
          Asesoría estratégica gratuita
        </Badge>
        <h1
          id="llc-b-title"
          class="font-display text-4xl leading-[1.04] font-bold tracking-[-.04em] sm:text-6xl lg:text-7xl"
        >
          Tu LLC en Estados Unidos,
          <span class="text-primary mt-2 block">bien hecha</span>
        </h1>
        <p
          class="mt-7 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg"
        >
          Te guiamos para evaluar el estado adecuado para tu LLC y estructurarla
          con criterios legales, fiscales y bancarios, reduciendo riesgos.
        </p>
        <Button
          variant="primary"
          class="mt-4 inline-flex md:hidden"
          href="#agendar-b"
        >
          Agendar
        </Button>
        <p class="mt-5 max-w-2xl text-xs leading-relaxed text-white/55">
          SCI es una consultora privada e independiente: no es una agencia
          gubernamental ni está afiliada o respaldada por una. Brindamos
          orientación, preparación documental y acompañamiento; la autoridad
          competente decide la emisión y los plazos.
        </p>
      </div>

      <dl class="grid gap-5 border-t border-white/10 pt-7 md:grid-cols-3">
        {
          benefits.map(([title, description]) => (
            <div class="border-primary/55 border-l-2 pl-4">
              <dt class="text-sm font-semibold text-white">{title}</dt>
              <dd class="mt-1 text-xs text-white/55">{description}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <Card
      id="agendar-b"
      size="md"
      class="min-h-screen rounded-none border-0 bg-[#0d2537] p-0 text-white shadow-[-24px_0_60px_-30px_rgba(0,0,0,.8)]"
    >
      <CardHeader class="bg-white px-6 py-7 text-center sm:px-11">
        <CardTitle class="font-display text-xl font-bold text-[#0d2537]">
          Agendar Asesoría Gratis
        </CardTitle>
        <CardDescription class="text-sm text-slate-500">
          Tres pasos y queda reservada
        </CardDescription>
      </CardHeader>

      <Form id="onboarding-form-b" novalidate class="gap-0">
        <CardContent class="px-6 py-7 sm:px-11 sm:py-8">
          <ol
            class="mb-7 flex items-center"
            aria-label="Progreso de la reserva"
          >
            {
              ["Tu caso", "Tus datos", "Tu horario"].map((label, index) => (
                <li class="contents">
                  {index > 0 && (
                    <span
                      class="step-line-b mx-2 h-px flex-1 bg-white/15 transition-colors"
                      data-line={index}
                      aria-hidden="true"
                    />
                  )}
                  <span
                    class="step-b flex shrink-0 items-center gap-2"
                    data-step-indicator={index + 1}
                  >
                    <span class="step-number-b grid size-6 place-items-center rounded-full border border-white/15 bg-white/8 text-[.7rem] font-semibold text-white/55">
                      <span class="step-value-b">{index + 1}</span>
                      <Check
                        class="step-check-b hidden size-3.5"
                        aria-hidden="true"
                      />
                    </span>
                    <span class="step-label-b text-xs font-medium text-white/45">
                      {label}
                    </span>
                  </span>
                </li>
              ))
            }
          </ol>

          <section class="onboarding-step-b" data-step="1">
            <h2 class="font-display text-xl font-semibold">
              ¿Para qué quieres tu LLC?
            </h2>
            <p class="mt-1.5 text-sm leading-relaxed text-white/55">
              Elige la actividad principal. Con eso preparamos tu asesoría antes
              de la llamada.
            </p>

            <input
              id="activity-b"
              type="hidden"
              name="activity"
              value=""
              required
            />
            <input
              type="hidden"
              name="advice"
              value="Sí, quiero revisar mi caso con un experto"
            />
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="onboarding-website-b">Sitio web</label>
              <input
                id="onboarding-website-b"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="mt-5 space-y-5">
              {
                activityGroups.map((group) => (
                  <fieldset class="space-y-2.5">
                    <legend class="text-primary text-xs font-bold tracking-[.1em] uppercase">
                      {group.label}
                    </legend>
                    <div class="grid gap-2 sm:grid-cols-2">
                      {group.activities.map((activity) => (
                        <Button
                          type="button"
                          variant="outline"
                          class="activity-button-b aria-pressed:border-primary aria-pressed:bg-primary/15 h-auto min-h-13 justify-between rounded-xl border-white/15 bg-white/5 px-4 py-3 text-left text-sm whitespace-normal text-white hover:border-white/35 hover:bg-white/10 hover:text-white"
                          data-value={activity}
                          aria-pressed="false"
                        >
                          <span>{activity}</span>
                          <span class="activity-check-wrap-b grid size-4.5 shrink-0 place-items-center rounded-full border border-white/25">
                            <Check
                              class="activity-check-b hidden size-3"
                              aria-hidden="true"
                            />
                          </span>
                        </Button>
                      ))}
                    </div>
                  </fieldset>
                ))
              }
            </div>

            <div class="mt-6">
              <p
                id="activity-hint-b"
                class="mb-2 text-center text-xs text-white/40"
                aria-live="polite"
              >
                Elige una actividad para continuar
              </p>
              <Button
                id="continue-to-contact-b"
                type="button"
                variant="primary"
                size="lg"
                class="w-full rounded-xl font-semibold"
              >
                Continuar
              </Button>
            </div>
          </section>

          <section class="onboarding-step-b hidden" data-step="2">
            <h2
              id="contact-title-b"
              class="font-display text-xl font-semibold"
              tabindex="-1"
            >
              ¿A dónde te enviamos la cita?
            </h2>
            <p class="mt-1.5 text-sm leading-relaxed text-white/55">
              Te llega el enlace de Zoom y un recordatorio antes de la llamada.
            </p>

            <div class="mt-5 space-y-4">
              <div class="grid gap-4 sm:grid-cols-2">
                <Field name="name" class="gap-2">
                  <FieldLabel for="full-name-b" class="text-white/85">
                    Nombre completo
                  </FieldLabel>
                  <FieldControl
                    id="full-name-b"
                    name="name"
                    type="text"
                    autocomplete="name"
                    minlength="3"
                    required
                    placeholder="Tu nombre y apellido"
                    class="border-white/15 bg-white/5 text-white placeholder:text-white/35"
                  />
                  <FieldError match="valueMissing"
                    >Escribe tu nombre completo.</FieldError
                  >
                  <FieldError match="tooShort"
                    >Escribe al menos tres caracteres.</FieldError
                  >
                </Field>
                <Field name="email" class="gap-2">
                  <FieldLabel for="email-b" class="text-white/85">
                    Correo electrónico
                  </FieldLabel>
                  <FieldControl
                    id="email-b"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    placeholder="nombre@empresa.com"
                    class="border-white/15 bg-white/5 text-white placeholder:text-white/35"
                  />
                  <FieldError match="valueMissing"
                    >Escribe tu correo.</FieldError
                  >
                  <FieldError match="typeMismatch"
                    >Escribe un correo válido.</FieldError
                  >
                </Field>
              </div>

              <div class="grid grid-cols-[7rem_1fr] items-start gap-2">
                <Field class="gap-2">
                  <FieldLabel for="country-code-b" class="text-white/85">
                    País
                  </FieldLabel>
                  <NativeSelect
                    id="country-code-b"
                    name="countryCode"
                    class="border-white/15 bg-white/5 text-white"
                  >
                    <NativeSelectOption value="+593">EC +593</NativeSelectOption
                    >
                    <NativeSelectOption value="+52">MX +52</NativeSelectOption>
                    <NativeSelectOption value="+57">CO +57</NativeSelectOption>
                    <NativeSelectOption value="+54">AR +54</NativeSelectOption>
                    <NativeSelectOption value="+34">ES +34</NativeSelectOption>
                    <NativeSelectOption value="+1">US +1</NativeSelectOption>
                  </NativeSelect>
                </Field>
                <Field name="phone" class="gap-2">
                  <FieldLabel for="phone-b" class="text-white/85">
                    Teléfono / WhatsApp
                  </FieldLabel>
                  <FieldControl
                    id="phone-b"
                    name="phone"
                    type="tel"
                    inputmode="tel"
                    autocomplete="tel"
                    minlength="7"
                    maxlength="15"
                    pattern="[0-9+\-().\s]+"
                    required
                    placeholder="099 123 4567"
                    class="border-white/15 bg-white/5 text-white placeholder:text-white/35"
                  />
                  <FieldError match="valueMissing"
                    >Escribe tu número.</FieldError
                  >
                  <FieldError match="tooShort"
                    >Escribe un teléfono válido.</FieldError
                  >
                  <FieldError match="patternMismatch"
                    >Revisa el formato del teléfono.</FieldError
                  >
                </Field>
              </div>

              <Field class="gap-2">
                <FieldLabel for="question-b" class="text-white/85">
                  ¿Qué duda principal quieres resolver?
                  <span class="font-normal text-white/40"> Opcional</span>
                </FieldLabel>
                <Textarea
                  id="question-b"
                  name="question"
                  rows={3}
                  placeholder="Ej.: no sé si me conviene Wyoming o Florida, ni qué pasa con mis impuestos aquí."
                  class="min-h-20 resize-none border-white/15 bg-white/5 text-white placeholder:text-white/35"
                />
              </Field>
            </div>

            <div class="mt-6 grid grid-cols-[minmax(7rem,32%)_1fr] gap-2.5">
              <Button
                type="button"
                variant="outline"
                class="back-button-b border-white/20 bg-transparent text-white hover:bg-white/10 hover:text-white"
                data-target="1"
              >
                Volver
              </Button>
              <Button
                id="continue-to-schedule-b"
                type="button"
                variant="primary"
                class="rounded-xl font-semibold"
              >
                Elegir horario
              </Button>
            </div>
            <p
              id="form-status-b"
              class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-white/40"
              aria-live="polite"
            >
              <Lock class="size-3" aria-hidden="true" />
              Tus datos se usan solo para gestionar esta asesoría.
            </p>
          </section>

          <section class="onboarding-step-b hidden" data-step="3">
            <h2
              id="schedule-title-b"
              class="font-display text-xl font-semibold"
              tabindex="-1"
            >
              Elige tu horario
            </h2>
            <p class="mt-1.5 text-sm leading-relaxed text-white/55">
              Selecciona directamente en Zcal el día y la hora que mejor te
              convengan.
            </p>

            <div
              class="mt-5 overflow-hidden rounded-2xl border border-white/10 bg-white"
            >
              <iframe
                id="zcal-frame-b"
                title="Calendario de reserva — Sotomayor Consulting"
                src="about:blank"
                loading="eager"
                allow="clipboard-write; fullscreen"
                class="h-[760px] w-full border-0"></iframe>
            </div>
            <p class="mt-4 text-center text-xs text-white/50">
              ¿No carga el calendario?
              <a
                id="zcal-open-b"
                href="https://zcal.co/t/agendar-asesoria-llc/60-USA"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary font-semibold underline underline-offset-4"
              >
                Ábrelo en una pestaña nueva
              </a>.
            </p>
          </section>
        </CardContent>
      </Form>
    </Card>
  </div>
</main>

<script>
  const scope = document.querySelector<HTMLElement>("[data-llc-onboarding-b]");
  const form = scope?.querySelector<HTMLFormElement>("#onboarding-form-b");

  if (scope && form) {
    const activeForm = form;
    const activityInput = form.querySelector<HTMLInputElement>("#activity-b");
    const activityHint = form.querySelector<HTMLElement>("#activity-hint-b");
    const continueToContact = form.querySelector<HTMLButtonElement>(
      "#continue-to-contact-b",
    );
    const continueToSchedule = form.querySelector<HTMLButtonElement>(
      "#continue-to-schedule-b",
    );
    const status = form.querySelector<HTMLElement>("#form-status-b");
    const zcalFrame = form.querySelector<HTMLIFrameElement>("#zcal-frame-b");
    const zcalOpen = form.querySelector<HTMLAnchorElement>("#zcal-open-b");
    let submissionId = "";
    let isSubmitting = false;

    if (continueToContact) continueToContact.disabled = true;

    function showStep(step: number) {
      activeForm
        .querySelectorAll<HTMLElement>(".onboarding-step-b")
        .forEach((panel) => {
          panel.classList.toggle("hidden", Number(panel.dataset.step) !== step);
        });

      activeForm
        .querySelectorAll<HTMLElement>("[data-step-indicator]")
        .forEach((indicator) => {
          const indicatorStep = Number(indicator.dataset.stepIndicator);
          const isCurrent = indicatorStep === step;
          const isDone = indicatorStep < step;
          indicator
            .querySelector(".step-number-b")
            ?.classList.toggle("step-active-b", isCurrent);
          indicator
            .querySelector(".step-label-b")
            ?.classList.toggle("step-label-active-b", isCurrent);
          indicator
            .querySelector(".step-value-b")
            ?.classList.toggle("hidden", isDone);
          indicator
            .querySelector(".step-check-b")
            ?.classList.toggle("hidden", !isDone);
          indicator
            .querySelector(".step-number-b")
            ?.classList.toggle("step-done-b", isDone);
        });

      activeForm
        .querySelectorAll<HTMLElement>("[data-line]")
        .forEach((line) => {
          line.classList.toggle(
            "step-line-active-b",
            Number(line.dataset.line) < step,
          );
        });

      const headingSelector =
        step === 2
          ? "#contact-title-b"
          : step === 3
            ? "#schedule-title-b"
            : null;
      if (headingSelector) {
        activeForm
          .querySelector<HTMLElement>(headingSelector)
          ?.focus({ preventScroll: true });
      }

      const panel = activeForm.closest<HTMLElement>("[data-sw-card]");
      if (panel) panel.scrollTop = 0;
    }

    function setSubmitting(submitting: boolean) {
      isSubmitting = submitting;
      if (!continueToSchedule) return;
      continueToSchedule.disabled = submitting;
      continueToSchedule.textContent = submitting
        ? "Abriendo calendario..."
        : "Elegir horario";
      if (submitting) continueToSchedule.setAttribute("aria-busy", "true");
      else continueToSchedule.removeAttribute("aria-busy");
    }

    function setStatus(message: string, error = false) {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle("text-red-300", error);
      status.classList.toggle("text-white/40", !error);
    }

    function validateContactFields() {
      const fields = ["#full-name-b", "#email-b", "#phone-b"]
        .map((selector) => activeForm.querySelector<HTMLInputElement>(selector))
        .filter((field): field is HTMLInputElement => Boolean(field));
      const invalidField = fields.find((field) => !field.checkValidity());
      if (!invalidField) return true;
      invalidField.reportValidity();
      invalidField.focus();
      return false;
    }

    function getSubmissionId() {
      if (submissionId) return submissionId;
      if (typeof globalThis.crypto?.randomUUID === "function") {
        submissionId = globalThis.crypto.randomUUID();
        return submissionId;
      }
      submissionId = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(
        /[xy]/g,
        (character) => {
          const random = Math.floor(Math.random() * 16);
          const value = character === "x" ? random : (random & 0x3) | 0x8;
          return value.toString(16);
        },
      );
      return submissionId;
    }

    function buildZcalUrl(values: FormData) {
      const countryCode = String(values.get("countryCode") ?? "");
      const localPhone = String(values.get("phone") ?? "")
        .replace(/\D/g, "")
        .replace(/^0+/, "");
      const phone = `${countryCode}${localPhone}`;
      const url = new URL("https://zcal.co/t/agendar-asesoria-llc/60-USA");
      url.searchParams.set("name", String(values.get("name") ?? ""));
      url.searchParams.set("email", String(values.get("email") ?? ""));
      url.searchParams.set("smsPhone", phone);
      url.searchParams.set("a0", phone);
      url.searchParams.set("a1", String(values.get("activity") ?? ""));
      url.searchParams.set("a2", String(values.get("advice") ?? ""));
      url.searchParams.set("a3", String(values.get("question") ?? ""));
      return url.toString();
    }

    activeForm
      .querySelectorAll<HTMLButtonElement>(".activity-button-b")
      .forEach((button) => {
        button.addEventListener("click", () => {
          activeForm
            .querySelectorAll<HTMLButtonElement>(".activity-button-b")
            .forEach((option) => {
              const selected = option === button;
              option.setAttribute("aria-pressed", String(selected));
              option
                .querySelector(".activity-check-b")
                ?.classList.toggle("hidden", !selected);
              option
                .querySelector(".activity-check-wrap-b")
                ?.classList.toggle("activity-check-selected-b", selected);
            });
          if (activityInput) activityInput.value = button.dataset.value ?? "";
          if (activityHint) activityHint.textContent = "Actividad seleccionada";
          if (continueToContact) continueToContact.disabled = false;
        });
      });

    continueToContact?.addEventListener("click", () => {
      if (!activityInput?.value) return;
      showStep(2);
    });

    continueToSchedule?.addEventListener("click", () =>
      activeForm.requestSubmit(),
    );

    activeForm
      .querySelectorAll<HTMLButtonElement>(".back-button-b")
      .forEach((button) => {
        button.addEventListener("click", () =>
          showStep(Number(button.dataset.target)),
        );
      });

    activeForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (isSubmitting) return;

      if (!validateContactFields()) {
        showStep(2);
        return;
      }

      const values = new FormData(activeForm);
      const currentSubmissionId = getSubmissionId();
      setSubmitting(true);
      setStatus("Guardando tu asesoría...");

      try {
        const response = await fetch("/api/leads", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            submissionId: currentSubmissionId,
            name: String(values.get("name") ?? ""),
            email: String(values.get("email") ?? ""),
            countryCode: String(values.get("countryCode") ?? ""),
            phone: String(values.get("phone") ?? ""),
            activity: String(values.get("activity") ?? ""),
            advice: String(values.get("advice") ?? ""),
            question: String(values.get("question") ?? ""),
            source: "tu-llc_en-usa-index-b",
            website: String(values.get("website") ?? ""),
          }),
        });

        if (!response.ok) {
          throw new Error(`Lead request failed with status ${response.status}`);
        }

        const trackingWindow = window as Window & {
          dataLayer?: Array<Record<string, unknown>>;
        };
        trackingWindow.dataLayer = trackingWindow.dataLayer || [];
        trackingWindow.dataLayer.push({ event: "lead_datos_completados" });
        try {
          localStorage.setItem("llcLeadSubmissionId", currentSubmissionId);
        } catch {
          // Storage is optional; the successful lead submission must continue.
        }

        const zcalUrl = buildZcalUrl(values);
        if (zcalFrame) zcalFrame.src = zcalUrl;
        if (zcalOpen) zcalOpen.href = zcalUrl;
        setSubmitting(false);
        showStep(3);
        scope.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch {
        setStatus(
          "No pudimos guardar tu asesoría. Revisa tu conexión e inténtalo nuevamente.",
          true,
        );
        setSubmitting(false);
      }
    });

    showStep(1);
  }
</script>

<script is:inline>
  // Asegura que dataLayer exista antes de hacer el push
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    'event': 'lead_datos_completados'
  });
</script>

<style>
  .onboarding-step-b:not(.hidden) {
    animation: step-enter-b 220ms ease-out both;
  }

  :global(.step-active-b) {
