</main>

<script>
  import { gsap } from "gsap";

  const scope = document.querySelector<HTMLElement>("[data-llc-onboarding]");
  const form = scope?.querySelector<HTMLFormElement>("#onboarding-form");

  if (scope) {
    const allCounters = Array.from(
      scope.querySelectorAll<HTMLElement>("[data-fomo-counter]"),
    );
    const counterKeys = [
      ...new Set(
        allCounters
          .map((counter) => counter.dataset.counterKey)
          .filter((key): key is string => Boolean(key)),
      ),
    ];
    const counterTimers = new Set<number>();
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    counterKeys.forEach((key) => {
      const counters = allCounters.filter(
        (counter) => counter.dataset.counterKey === key,
      );
      const labels = Array.from(
        scope.querySelectorAll<HTMLElement>("[data-fomo-label]"),
      ).filter((label) => label.dataset.counterKey === key);
      const firstCounter = counters[0];
      let counterValue = Number(firstCounter?.dataset.countStart ?? 0);
      const counterMax = Number(firstCounter?.dataset.countMax ?? 10_000);

      const renderCounter = () => {
        const formattedValue = Math.max(0, counterValue).toLocaleString("es");
        counters.forEach((counter) => {
          counter.textContent = formattedValue;
        });
        labels.forEach((label) => {
          label.textContent =
            counterValue === 1
              ? (label.dataset.labelSingular ?? "")
              : (label.dataset.labelPlural ?? "");
        });
      };

      const scheduleCounterIncrement = () => {
        if (counterValue >= counterMax || counters.length === 0) return;

        // DEMO: reemplazar este temporizador por el valor devuelto por la API.
        const delay = gsap.utils.random(8_000, 15_000, 1);
        const timer = window.setTimeout(() => {
          counterTimers.delete(timer);
          if (!document.hidden) {
            counterValue = Math.min(counterValue + 1, counterMax);
            renderCounter();

            if (!reduceMotion.matches) {
              gsap.fromTo(
                counters,
                { y: -3, autoAlpha: 0.65 },
                {
                  y: 0,
                  autoAlpha: 1,
                  duration: 0.35,
                  ease: "power2.out",
                  overwrite: "auto",
                },
              );
            }
          }

          scheduleCounterIncrement();
        }, delay);
        counterTimers.add(timer);
      };

      if (
        Number.isFinite(counterValue) &&
        Number.isFinite(counterMax) &&
        counterValue >= 0 &&
        counterMax >= counterValue
      ) {
        renderCounter();
        scheduleCounterIncrement();
      }
    });

    window.addEventListener(
      "pagehide",
      () => counterTimers.forEach((timer) => window.clearTimeout(timer)),
      { once: true },
    );
  }

  if (scope && form) {
    const activeForm = form;
    const activityInput = form.querySelector<HTMLInputElement>("#activity");
    const activityHint = form.querySelector<HTMLElement>("#activity-hint");
    const continueToContact = form.querySelector<HTMLButtonElement>(
      "#continue-to-contact",
    );
    const continueToSchedule = form.querySelector<HTMLButtonElement>(
      "#continue-to-schedule",
    );
    const contactTitle = form.querySelector<HTMLElement>("#contact-title");
    const calendarRoot = form.querySelector<HTMLElement>(
      "[data-calendar-paso]",
    );
    let trackingId = "";
    let trackingSent = false;

    if (continueToContact) continueToContact.disabled = true;

    function showStep(step: number) {
      form
        ?.querySelectorAll<HTMLElement>(".onboarding-step")
        .forEach((panel) => {
          panel.classList.toggle("hidden", Number(panel.dataset.step) !== step);
        });

      form
        ?.querySelectorAll<HTMLElement>("[data-step-indicator]")
        .forEach((indicator) => {
          const indicatorStep = Number(indicator.dataset.stepIndicator);
          const isCurrent = indicatorStep === step;
          const isDone = indicatorStep < step;
          indicator
            .querySelector(".step-number")
            ?.classList.toggle("step-active", isCurrent);
          indicator
            .querySelector(".step-label")
            ?.classList.toggle("step-label-active", isCurrent);
          indicator
            .querySelector(".step-value")
            ?.classList.toggle("hidden", isDone);
          indicator
            .querySelector(".step-check")
            ?.classList.toggle("hidden", !isDone);
          indicator
            .querySelector(".step-number")
            ?.classList.toggle("step-done", isDone);
        });

      form?.querySelectorAll<HTMLElement>("[data-line]").forEach((line) => {
        line.classList.toggle(
          "step-line-active",
          Number(line.dataset.line) < step,
        );
      });

      const headingSelector =
        step === 2 ? "#contact-title" : step === 3 ? "#schedule-title" : null;
      if (headingSelector) {
        form
          ?.querySelector<HTMLElement>(headingSelector)
          ?.focus({ preventScroll: true });
      }
    }

    function validateContactFields() {
      const fields = ["#full-name", "#email", "#phone", "#question"]
        .map((selector) =>
          activeForm.querySelector<HTMLInputElement | HTMLTextAreaElement>(
            selector,
          ),
        )
        .filter((field): field is HTMLInputElement | HTMLTextAreaElement =>
          Boolean(field),
        );
      const invalidField = fields.find((field) => !field.checkValidity());
      if (!invalidField) return true;
      invalidField.reportValidity();
      invalidField.focus();
      return false;
    }

    function getTrackingId() {
      if (trackingId) return trackingId;
      if (typeof globalThis.crypto?.randomUUID === "function") {
        trackingId = globalThis.crypto.randomUUID();
        return trackingId;
      }
      trackingId = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(
        /[xy]/g,
        (character) => {
          const random = Math.floor(Math.random() * 16);
          const value = character === "x" ? random : (random & 0x3) | 0x8;
          return value.toString(16);
        },
      );
      return trackingId;
    }

    function trackScheduleSelection(currentTrackingId: string) {
      if (trackingSent) return;
      try {
        const uuidPattern =
          /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

        if (!uuidPattern.test(currentTrackingId)) return;
        trackingSent = true;

        const trackingWindow = window as Window & {
          dataLayer?: Array<Record<string, unknown>>;
          SCITikTokRUKarlaQueue?: Array<{
            type: string;
            id: string;
          }>;
        };

        trackingWindow.dataLayer = trackingWindow.dataLayer || [];
        trackingWindow.dataLayer.push({
          event: "lead_datos_completados",
          submission_id: currentTrackingId,
        });
        trackingWindow.dataLayer.push({
          event: "elegir_horario",
          submission_id: currentTrackingId,
        });

        trackingWindow.SCITikTokRUKarlaQueue =
          trackingWindow.SCITikTokRUKarlaQueue || [];
        trackingWindow.SCITikTokRUKarlaQueue.push({
          type: "lead",
          id: currentTrackingId,
        });

        window.dispatchEvent(new CustomEvent("sci:tiktok:ru:karla:flush"));
      } catch {
        // Un fallo de medición no debe interrumpir el formulario.
      }
    }

    form
      .querySelectorAll<HTMLButtonElement>(".activity-button")
      .forEach((button) => {
        button.addEventListener("click", () => {
          form
            .querySelectorAll<HTMLButtonElement>(".activity-button")
            .forEach((option) => {
              option.setAttribute("aria-pressed", String(option === button));
              option
                .querySelector(".activity-check")
                ?.classList.toggle("hidden", option !== button);
            });
          if (activityInput) activityInput.value = button.dataset.value ?? "";
          if (activityHint) activityHint.textContent = "Actividad seleccionada";
          if (continueToContact) continueToContact.disabled = false;
        });
      });

    continueToContact?.addEventListener("click", () => {
      if (!activityInput?.value) return;
      showStep(2);
    });

    continueToSchedule?.addEventListener("click", () => form.requestSubmit());

    form
      .querySelectorAll<HTMLButtonElement>(".back-button")
      .forEach((button) => {
        button.addEventListener("click", () =>
          showStep(Number(button.dataset.target)),
        );
      });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!validateContactFields()) {
        showStep(2);
        return;
      }

      const currentTrackingId = getTrackingId();
      trackScheduleSelection(currentTrackingId);

      showStep(3);
      calendarRoot?.dispatchEvent(
        new CustomEvent("calendar:activate", { bubbles: true }),
      );
    });

    form.addEventListener("calendar:back", () => {
      showStep(2);
      contactTitle?.focus({ preventScroll: true });
      scope.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    showStep(1);
  }
</script>

