    </div>
  </section>

  <section
    aria-labelledby="cierre-title"
    class="relative z-10 px-4 py-16 sm:px-8 sm:py-20 lg:py-24"
  >
    <Card
      class="mx-auto max-w-6xl overflow-hidden border-white/10 bg-black text-center text-white ring-white/10"
    >
      <CardContent class="flex flex-col items-center px-6 py-12 sm:px-10 sm:py-16">
        <h2
          id="cierre-title"
          class="font-display max-w-4xl text-3xl leading-tight text-white sm:text-4xl lg:text-5xl"
        >
          Tu LLC empieza bien o empieza a costarte más.
        </h2>
        <h3 class="mt-4 text-xl font-semibold text-white/70 sm:text-2xl">
          Diseña primero. Incorpora después.
        </h3>
        <Button
          as="a"
          href="#agendar"
          variant="primary"
          size="lg"
          class="mt-8 rounded-xl bg-[#ff2525] px-7 font-bold text-white hover:bg-[#e51f1f]"
        >
          Agenda tu reunión
        </Button>
      </CardContent>
    </Card>
  </section>

  <Timeline />

  <div class="relative z-10 bg-black/10 py-20">
    <Insight1
      label="Cómo funciona"
      title="De la duda a un plan concreto en tres pasos."
      Cta="Agendar mi asesoría"
      CtaLink="#agendar"
      CtaLabels="60 min · por Zoom · sin compromiso"
      steps={steps1}
    />
  </div>

  <div class="relative z-10 my-10 py-20" id="estados">
    <Insight2
      label="Elige tu estado ideal"
      title="Delaware, Wyoming o Florida. No todos los estados son iguales para una incorporación."
      description="Recibe la consultoría de un equipo experto y define el estado que corresponde a tu operación antes de incorporar tu LLC, sin errores. Diez años estructurando compañías en Estados Unidos para clientes de toda América Latina."
      Cta="Evalúa tu estado sin costo"
      CtaLink="#agendar"
      CtaLabels="60 min · por Zoom · sin compromiso"
      CtaAdvice="Las tasas estatales las cobra cada estado y se pagan por separado."
      steps={steps2}
    />
  </div>

  <div
    class="relative z-10 overflow-hidden py-20 before:absolute before:inset-0 before:-z-10 before:[background-image:var(--hero-image)] before:[background-size:cover] before:[background-position:center] before:[background-repeat:no-repeat] before:opacity-20 before:content-['']"
    id="servicio"
    style={`--hero-image: url('${FondoDiv.src}');`}
  >
    <Insight2
      label="Consultoría para tu LLC"
      title="Analizamos tu caso y tu actividad antes de recomendarte una estructura."
      description="Una sesión de 60 minutos por Zoom, sin costo y sin compromiso, con un asesor del estudio. Diez años de experiencia en estructuras internacionales."
      Cta="Agenda una llamada sin costo"
      CtaLink="#agendar"
      CtaLabels="100% remoto y en español"
      steps={steps3}
    />
  </div>

  <div class="relative z-10 my-10 py-20">
    <Pricing
      id="precios"
      heading="Valores únicos. Las tasas del Estado se pagan aparte y las cobra el Estado."
      description="El plan ideal según tu caso lo definimos en la primera asesoría."
      plans={planes}
    />
  </div>

  <div class="relative z-10 bg-black/10 py-20">
    <Faq
      id="preguntas"
      label="Preguntas frecuentes"
      title="Lo que debes saber antes de empezar."
      description="Si tu duda no aparece, la resolvemos durante la asesoría."
      faqs={faqs}
      Cta="Resuleve tus dudas en la asesoría"
      CtaLink="#agendar"
      CtaLabels="60 min · por Zoom · sin compromiso"
    />
