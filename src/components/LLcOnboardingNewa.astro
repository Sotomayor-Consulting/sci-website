          class="noise-surface relative isolate overflow-hidden border-b border-white/10 bg-[#ff2525] p-6 sm:p-10 lg:border-r lg:border-b-0"
        >
          <p class="text-xs font-bold tracking-[0.18em] text-white/75 uppercase">
            El costo de improvisar
          </p>
          <CardTitle>
            <h2
              id="incorporar-bien-title"
              class="font-display text-3xl leading-tight text-white sm:text-4xl lg:text-5xl"
