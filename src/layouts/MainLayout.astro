---
// Importing necessary components
import Meta from "@components/Meta.astro";
import Navbar from "@components/sections/navbar&footer/NavbarMegaMenu.astro";
import FooterSection from "@components/sections/navbar&footer/FooterSection.astro";
import { SITE } from "@data/constants";
import "@styles/global.css";
import BotonWhatsapp from "@components/ui/buttons/BtnWhatsapp.astro";
import VideoBubble from "@components/ui/buttons/VideoBubble.astro";
import Schemajson from "@components/sections/SEO/json-enriquesido.astro";
import GoogleTagManager from "@components/ui/blocks/GoogleTagManager.astro";

const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith("/en");
const isPortuguese = pathname.startsWith("/pr");
const lenguaje = isEnglish ? "en-US" : isPortuguese ? "pt-BR" : "es-EC";

// Setting expected props
const {
  title = SITE.title,
  meta,
  structuredData,
  lang = lenguaje,
  customDescription = null,
  customOgTitle = null,
} = Astro.props;

// Interface to type-check the properties
interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
}
---

<html lang={lang} class="scrollbar-hide lenis lenis-smooth scroll-pt-16">
  <head>
    {/* Adding metadata to the HTML document */}
    <Schemajson />
    <Meta
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
    />
    {/* Define the title of the page */}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Blinker:wght@400;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Blinker:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Blinker:wght@400;600;700&display=swap"
      />
    </noscript>
    <script is:inline>
      // Script to handle dark mode. It will check if the theme is stored in localStorage or if dark theme is preferred by system settings
      if (
        localStorage.getItem("hs_theme") === "dark" ||
        (!("hs_theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <script>
      import "@scripts/lenisSmoothScroll.js";
    </script>

    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
    <GoogleTagManager />
  </head>
  <body
    class="selection:bg-primario-black dark:selection:bg-secundario dark:selection:text-primario-black flex min-h-screen flex-col bg-neutral-200 selection:text-neutral-200 dark:bg-[#171717]"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TNRQGDM"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <Navbar />
    <div>
      <slot name="hero" />
    </div>
    <div
      class="scrollbar-hide mx-auto w-full max-w-(--breakpoint-2xl) grow px-4 sm:px-6 lg:px-8"
    >
      <BotonWhatsapp />
      <!-- <VideoBubble /> -->
      <main>
        <slot />
      </main>
    </div>
    <FooterSection />
    <script>
      import { HSStaticMethods } from "preline";

      const initPreline = () => {
        HSStaticMethods.autoInit();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initPreline, {
          once: true,
        });
      } else {
        initPreline();
      }

      document.addEventListener("astro:page-load", initPreline);
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
