---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

import webdesing from "@images/web-servicios.avif";
import TechServices from "@images/tech-servicios.avif";
import líneasTelf from "@images/voice-servicios.png";
import stripeImg from "@images/stripe-servicios.png";

import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Criação de Agentes de IA",
    subTitle:
      "Aproveite o poder da tecnologia para otimizar suas operações e impulsionar seu negócio. Oferecemos soluções tecnológicas sob medida, desde a criação de agentes de IA para automatizar processos até o desenvolvimento de páginas web que estabelecem uma presença digital sólida.",
    single: true,
    imgOne: TechServices,
    imgOneAlt: "empresários revisando computador",
    btnExists: true,
    btnTitle: "Saiba mais",
    btnURL: "/pr/servicios-empresariales/creación-de-agentes-de-ia/",
  },
  {
    isRightSection: false,
    title: "Criação de Páginas Web",
    subTitle:
      "Sua presença digital é a chave para conectar com seu público. Oferecemos um serviço integral de criação de páginas web, projetadas para transmitir uma imagem profissional e sólida.",
    img: webdesing,
    imgAlt: "Casa em escala com um contrato",
    btnExists: true,
    btnTitle: "Saiba mais",
    btnURL: "/pr/servicios-empresariales/paginas-web/",
  },
  {
    isRightSection: true,
    title: "Criação de Linhas Telefônicas Internacionais",
    subTitle:
      "Nosso serviço de criação de linhas telefônicas internacionais com Google Voice permite gerenciar chamadas e mensagens de texto do seu dispositivo atual, projetando uma presença local nos Estados Unidos sem a necessidade de equipamento físico ou residência no país.",
    single: true,
    imgOne: líneasTelf,
    imgOneAlt: "google voice",
    btnExists: true,
    btnTitle: "Saiba mais",
    btnURL: "/pr/servicios-profesionales/lineas-internacionales/",
  },
  {
    isRightSection: false,
    title: "Acompanhamento para Solicitar e Configurar o Stripe",
    subTitle:
      "Orientamos você na preparação da solicitação e na configuração técnica do Stripe. O Stripe determina de forma independente a disponibilidade, a verificação e a ativação de cada conta.",
    img: stripeImg,
    imgAlt: "Imagem stripe",
    btnExists: true,
    btnTitle: "Saiba mais",
    btnURL: "/pr/servicios-profesionales/stripe-servicios/",
  },
];

const pageTitle: string = `Serviços | ${SITE.title}`;
const metaDescription =
  "Soluções de consultoria estratégica e operacional adaptadas às suas necessidades. A Sotomayor Consulting International oferece experiência em formação de empresas, serviços digitais e soluções de negócios internacionais.";
const ogTitle = "Serviços | Sotomayor Consulting International";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://sotomayorconsulting.com/pr/services",
    url: "https://sotomayorconsulting.com/pr/services",
    name: "Serviços | Sotomayor Consulting International",
    description:
      "Soluções de consultoria estratégica e operacional adaptadas às suas necessidades. A Sotomayor Consulting International oferece experiência em formação de empresas, serviços digitais e soluções de negócios internacionais.",

    isPartOf: {
      "@type": "WebSite",
      url: "https://sotomayorconsulting.com/pr",
      name: "Sotomayor Consulting International",
      description:
        "A Sotomayor Consulting International é sua parceira estratégica para o crescimento empresarial e otimização de processos.",
    },
    inLanguage: "pt-BR",
  }}
>
  <MainSection
    label="Apoiando seu crescimento"
    title="Soluções ótimas e integrais"
    description="Ajudamos pessoas, famílias e empresas a identificar requisitos, preparar documentos e acompanhar processos locais e internacionais, sem substituir autoridades nem garantir suas decisões."
    button="Fale conosco"
    label2="Assista agora"
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="Nossa Firma, Seus Resultados"
    subTitle="O compromisso da Sotomayor Consulting International com a excelência e confiança se reflete em cada um de nossos projetos. Estamos dedicados a fornecer serviços líderes do setor que garantem a proteção e o crescimento de seu patrimônio a longo prazo."
    mainStatTitle="96%"
    mainStatSubTitle="de nossos clientes classificam sua experiência com a Sotomayor Consulting International como excepcional."
    stats={[
      {
        stat: "99.8%",
        description: "Taxa de cumprimento de objetivos",
      },
      {
        stat: "5,000+",
        description: "processos de LLC acompanhados nos EUA",
      },
      {
        stat: "85%",
        description: "de crescimento em clientes, ano após ano.",
      },
    ]}
  />
</MainLayout>
