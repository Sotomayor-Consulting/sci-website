---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSectionVideos from "@components/sections/landing/HeroSectionVideos.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import faqs from "@data/pr/faqs.json";
import features from "@data/pr/features.json";
import pricing from "@data/pr/pricing.json";
import featureImage from "@images/home-image.jpg";
import CartasDeServiciosV2 from "@components/sections/landing/CartasDeServiciosV2.astro";
import GridServicios from "@/components/sections/features/GridServicios.astro";
import Banner from "@components/ui/banners/AnnouncementBanner.astro";
import RelayPartnerSection from "@components/sections/landing/RelayPartnerSection.astro";
import Evaluacion from "@components/sections/evaluacion/CallToActionEvaluacion.astro";
import Heroanimatev2 from "@components/sections/landing/Hero_animation_v2.astro";
---
<MainLayout>
  <Banner
    title="A Sotomayor Consulting International é uma empresa de consultoria, não um banco. Não concedemos crédito, mas oferecemos todo o nosso apoio na constituição da sua empresa, abertura de contas e soluções tecnológicas. Não somos uma entidade do Governo. Estamos aqui para assessorar você!"
    url="/"
    btnTitle="Saiba mais"
    btnId="xd"
  />

  <!-- <Heroanimate/> -->
  <Heroanimatev2
    title="Estruturamos sua expansão global com precisão legal, fiscal e tecnológica."
    spam="Expanda seu negócio para os EUA."
    description="A Sotomayor Consulting International é uma firma boutique de consultoria legal, fiscal e tecnológica que ajuda clientes (sobretudo internacionais) a criar empresas nos EUA e em outras jurisdições, conectá-las ao sistema financeiro (bancos/fintech), cumprir com impostos e contabilidade, e montar a infraestrutura digital (IA, web, Stripe, telefonia) necessária para operar globalmente."
    Btnlabel="Comece sua LLC"
    slot="hero"
  />

