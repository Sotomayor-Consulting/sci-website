    title=`Soluções 360° para LLCs, Tributação e Tecnologia Global`
    subTitle="A Sotomayor Consulting International é uma firma boutique de consultoria legal, fiscal e tecnológica que ajuda clientes (sobretudo internacionais) a criar empresas nos EUA e em outras jurisdições, conectá-las ao sistema financeiro (bancos/fintech), cumprir com impostos e contabilidade, e montar a infraestrutura digital (IA, web, Stripe, telefonia) necessária para operar globalmente."
    primaryBtn="Comece sua LLC "
    primaryBtnURL="/#precios"
    secondaryBtn="Nossos Serviços"
    secondaryBtnURL="/#cartas-servicios"
    rating=`<span class="font-bold">4.8</span> / 5`
    starCount={4}
    reviews=`From Over <span class="font-bold">12.8k</span> Reviews`
    alt="Vídeo de empresas, pessoas e desenvolvimento"
    titleslide2="Sua expansão global merece uma estrutura, não apenas um procedimento."
    descriptionslide2="Somos o aliado estratégico que cuida do seu patrimônio com rigor e acompanhamento especializado, assegurando que sua entrada no mundo seja sólida, correta e, acima de tudo, definitiva."
    dabgeslide3="Oferecemos clareza e segurança"
    tituloslide3="Sua visão em uma arquitetura legal sólida e estratégica."
    descriptionslide3="Na Sotomayor Consulting International, desenhamos a estrutura exata que seu patrimônio precisa para se expandir com sucesso. Somos arquitetos da sua segurança jurídica e fiscal nos Estados Unidos e no mundo."
    button1slide3="Diagnóstico Gratuito"
    button2slide3="Agende uma reunião"
  /> -->

  <RelayPartnerSection />

  <CartasDeServiciosV2
    title="Tudo para sua Empresa"
    subTitle="Oferecemos soluções de serviço personalizadas para profissionais, indivíduos, famílias e empresas, atendendo às suas necessidades específicas."
  />

  <FeaturesGeneral
    title="Conheça nosso aplicativo"
    subTitle="Organize sua LLC e sua empresa em um só lugar, com o acompanhamento da nossa equipe."
    src={featureImage}
    alt="ScrewFast products in floating boxes"
    features={features}
  />

  <GridServicios
    title="Produto destaque"
    description="Acompanhamos empreendedores globais na constituição da sua empresa nos EUA, no design tributário, na assessoria de assistência documental para onboarding bancário com terceiros e na assessoria de conformidade legal de qualquer parte do mundo."
    link="#precios"
    grid2="Países"
    grid3="Explore nossos serviços"
    grid3link="/services"
    grid4="Fale conosco"
    grid4link="/contact"
  />

  <TestimonialsSection
    title="Impulsione seus Projetos"
    subTitle="Na Sotomayor Consulting International, garantimos um início ágil com acompanhamento constante. Experimente a redefinição da assessoria."
    ;
    testimonials={[
      {
        content:
          "A Sotomayor Consulting International me deu uma solução clara para minha LLC. O processo foi direto e o suporte me ajudou e me assessorou a configurar e habilitar cobranças com processadores de pagamento de terceiros (p. ex., Stripe/PayPal). Recomendo o serviço.",
        author: "Diego Morales",
        role: "Empreendedor em comércio eletrônico",
        avatarSrc:
          "https://images.unsplash.com/photo-1624561172888-ac93c696e10c?q=80&w=389&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
      },
    ]}
    statistics={[
      {
        count: "5,000",
        description: "Empresas acompanhadas",
      },
      {
        count: "1,354",
        description: "Projetos realizados",
      },
      {
        count: "97%",
        description: "Satisfação",
      },
      {
        count: "10",
        description: "Anos de Experiência",
      },
    ]}
  />

  <Evaluacion
    title="Descubra se uma LLC é realmente a melhor estrutura para você."
    button="Realizar diagnóstico gratuito"
  >
    Evite erros legais e fiscais que podem custar milhares de dólares.
    <b>Em apenas 2 minutos, nosso diagnóstico gratuito</b> analisa sua situação específica
    e indica com total clareza se uma LLC nos EUA é a opção correta para
    o seu caso ou se existe uma alternativa melhor.
  </Evaluacion>

  <PricingSection pricing={pricing} />

  <FAQ title="Perguntas<br />Frequentes" faqs={faqs} />

  <HeroSectionAlt
    title="Vamos Trabalhar Juntos"
    subTitle="A SCI é um serviço integral especializado, meticulosamente desenhado com soluções globais em constituição de empresas, planejamento fiscal, serviços migratórios e imóveis internacionais."
    url="/contact"
    btnTitle="Fale conosco"
  />
</MainLayout>
