---
import { dataLLC } from "src/data_files/data-de-servicios";
import MainLayout from "@/layouts/MainLayoutv2.astro";
import Icono from "src/images/icon.svg";
import { Icon } from "astro-icon/components";
---

<MainLayout
  title={dataLLC.titulo}
  customDescription={dataLLC.titulo}
  customOgTitle={dataLLC.titulo}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `https://sotomayorconsulting.com/servicios/${dataLLC.categoria.toLowerCase().replace(/\s+/g, "-")}`,
    name: dataLLC.titulo,
    description: dataLLC.descripcion,
    brand: {
      "@type": "Brand",
      name: "Sotomayor Consulting",
    },
  }}
>
  <section
    class="mx-auto flex max-w-[85rem] flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <!-- Hero -->
    <div class="relative overflow-hidden">
      <div class="relative z-10">
        <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
          <div class="mx-auto max-w-2xl text-center">
            <p
              class="inline-block bg-linear-to-l from-secundario to-white bg-clip-text text-sm font-medium text-transparent dark:from-secundario dark:to-white"
            >
              Sotomayor Consulting International
            </p>

            <!-- Title -->
            <div class="mt-5 max-w-2xl">
              <h1
                class="block text-4xl font-semibold text-primario-black md:text-5xl lg:text-6xl dark:text-neutral-200"
              >
                {dataLLC.titulo}
              </h1>
            </div>
            <!-- End Title -->

            <div class="mt-5 max-w-3xl">
              <p class="text-lg text-primario-black dark:text-neutral-400">
                {dataLLC.descripcion}
              </p>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex justify-center gap-3">
              <a
                class="inline-flex items-center gap-x-2 rounded-lg border border-transparent bg-secundario px-4 py-3 text-sm font-medium text-white hover:bg-secundario/80 focus:bg-secundario focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
                target="_blank"
                href="https://zcal.co/t/agendar-asesoria-llc/60min"
              >
                Agendar una reunion
                <svg
                  class="size-4 shrink-0"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
                >
              </a>
              <a
                class="inline-flex items-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-sm font-medium text-primario-black hover:bg-gray-100 focus:bg-gray-100 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:text-white dark:hover:bg-neutral-800 dark:focus:bg-neutral-800"
                href="#precios"
              >
                <Icono class="size-4 shrink-0" />

                Ver planes
              </a>
            </div>
            <!-- End Buttons -->
          </div>
        </div>
      </div>
    </div>
    <!-- End Hero -->

    <!-- Cards -->
    <div class="overflow-hidden">
      <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <!-- Title -->
        <div class="mx-auto mb-4 max-w-2xl text-center">
          <h2
            class="text-3xl font-bold text-primario-black lg:text-4xl dark:text-neutral-200"
          >
            {dataLLC.titulofeatures}
          </h2>
        </div>
        <div class="mx-auto mb-8 max-w-2xl text-center">
          <p class="text-lg text-primario-black dark:text-neutral-400">
            {dataLLC.descripcionfeatures}
          </p>
        </div>
        <!-- End Title -->

        <!-- Icon Blocks -->
        <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
          <div class="flex flex-col">
            <!-- Icon Block -->

            <nav
              class="grid gap-x-1 md:flex"
              aria-label="Tabs"
              role="tablist"
              aria-orientation="horizontal"
            >
              {
                dataLLC.TarjetasFeatures.map((features, index) => (
                  <button
                    type="button"
                    class={
                      index === 0
                        ? "hs-tab-active:bg-secundario hs-tab-active:text-white hs-tab-active:hover:text-white hs-tab-active:dark:text-white active inline-flex flex-auto items-center justify-center gap-x-2 rounded-lg bg-transparent px-4 py-3 text-center text-sm font-medium text-primario-black hover:text-secundario focus:text-secundario focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:text-neutral-400 dark:hover:text-neutral-300 dark:focus:text-neutral-300"
                        : "hs-tab-active:bg-secundario hs-tab-active:text-white hs-tab-active:hover:text-white hs-tab-active:dark:text-white inline-flex flex-auto items-center justify-center gap-x-2 rounded-lg bg-transparent px-4 py-3 text-center text-sm font-medium text-primario-black hover:text-secundario focus:text-secundario focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:text-neutral-400 dark:hover:text-neutral-300 dark:focus:text-neutral-300"
                    }
                    id={`equal-width-elements-item-${index}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    data-hs-tab={`#equal-width-elements-${index}`}
                    aria-controls={`equal-width-elements-${index}`}
                    role="tab"
                  >
                    <Icon name={features.icono} class="text-2xl" />
                    {features.titulo}
                  </button>
                ))
              }
            </nav>

            <div class="mt-3">
              {
                dataLLC.TarjetasFeatures.map((features, index) => (
                  <div
                    id={`equal-width-elements-${index}`}
                    role="tabpanel"
                    class={index === 0 ? "" : "hidden"}
                    aria-labelledby={`equal-width-elements-item-${index}`}
                  >
                    <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
                      <div class="grid gap-12 md:grid-cols-2">
                        <div class="lg:w-3/4">
                          <h2 class="text-3xl font-bold text-primario-black lg:text-4xl dark:text-white">
                            {features.titulo}
                          </h2>
                          <p class="mt-3 text-primario-black dark:text-neutral-400">
                            {features.descripcion}
                          </p>
                        </div>
                        <div class="space-y-6 lg:space-y-10">
                          {features.lista.map((li) => (
                            <div class="flex gap-x-5 sm:gap-x-8">
                              <span class="mx-auto inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-gray-200 bg-secundario text-white shadow-2xs dark:border-neutral-700 dark:bg-secundario dark:text-white">
                                <Icon
                                  name="mingcute:check-fill"
                                  class="size-5 shrink-0"
                                />
                              </span>
                              <div class="grow">
                                <h3 class="text-base font-semibold text-primario-black sm:text-lg dark:text-neutral-200">
                                  {li}
                                </h3>
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>

            <!-- End Icon Block -->
          </div>
        </div>
        <!-- End Icon Blocks -->

        <div class="mt-7 text-center">
          <p class="text-xs text-primario-black dark:text-white">
            Los beneficios dependerán de los planes que elijas
          </p>
        </div>
      </div>
    </div>
    <!-- End Cards -->

    <!-- Cards -->
    <div class="overflow-hidden" id="precios">
      <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div>
          <div class="mx-auto mb-2 max-w-2xl text-center">
            <h2
              class="text-3xl font-bold text-primario-black lg:text-4xl dark:text-neutral-200"
            >
              {dataLLC.titulopricing}
            </h2>
          </div>
          <div class="mx-auto mb-8 max-w-2xl text-center">
            <p class="text-lg text-primario-black dark:text-neutral-400">
              {dataLLC.descripcionpricing}
            </p>
          </div>
        </div>

        <div class="relative xl:mx-auto xl:w-10/12">
          <!-- Grid -->
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
            {
              dataLLC.planes.map((plan) =>
                plan.categoria === "normal" ? (
                  <div>
                    <div class="relative z-10 grid h-full rounded-xl border border-gray-200 bg-white p-4 md:p-10 dark:border-neutral-800 dark:bg-neutral-900">
                      <h3 class="text-xl font-bold text-primario-black dark:text-neutral-200">
                        {plan.titulo}
                      </h3>
                      <div class="text-sm text-primario-black dark:text-neutral-500">
                        {plan.descripcion}
                      </div>

                      <div class="mt-5">
                        <span class="text-6xl font-bold text-primario-black dark:text-neutral-200">
                          ${plan.precio}
                        </span>
                        <span class="text-lg font-bold text-primario-black dark:text-neutral-200">
                          .00
                        </span>
                        <span class="ms-3 text-primario-black dark:text-neutral-500">
                          USD
                        </span>
                      </div>

                      <div class="mt-5 grid gap-y-2 py-4 first:pt-0 last:pb-0 sm:gap-x-6 sm:gap-y-0">
                        <ul class="space-y-2 text-sm sm:text-base">
                          {plan.anadido && (
                            <li class="flex gap-x-3">
                              <span class="text-primario-black dark:text-neutral-200">
                                {plan.anadido}
                              </span>
                            </li>
                          )}
                          {plan.lista.map((li) => (
                            <li class="flex gap-x-3">
                              <span class="mt-0.5 flex size-5 items-center justify-center rounded-full bg-blue-50 text-secundario dark:bg-secundario/30 dark:text-secundario">
                                <Icon
                                  name={plan.icono}
                                  class="size-3.5 shrink-0 text-secundario dark:text-white"
                                />
                              </span>
                              <span class="text-primario-black dark:text-neutral-200">
                                {li}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <div class="mt-5 grid gap-x-4 py-4 first:pt-0 last:pb-0">
                        <div class="flex items-end justify-end">
                          <a
                            href={plan.link}
                            class="inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-secundario px-4 py-3 text-sm font-medium text-white shadow-2xs hover:bg-secundario/80 focus:bg-secundario/80 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-secundario dark:text-white dark:hover:bg-secundario/80 dark:focus:bg-secundario/80"
                          >
                            {plan.boton}
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div>
                    <div class="relative z-10 grid rounded-xl border border-gray-200 bg-white p-5 shadow-xl shadow-gray-200 md:p-10 dark:border-neutral-800 dark:bg-neutral-900 dark:shadow-gray-900/20">
                      <h3 class="text-xl font-bold text-primario-black dark:text-neutral-200">
                        {plan.titulo}
                      </h3>
                      <div class="text-sm text-primario-black dark:text-neutral-500">
                        {plan.descripcion}
                      </div>
                      <span class="absolute end-0 top-0 animate-pulse rounded-se-xl rounded-es-xl bg-[#00b7db] px-3 py-1.5 text-xs font-medium text-white dark:bg-white dark:text-primario-black">
                        Más popular
                      </span>

                      <div class="mt-5">
                        <span class="text-6xl font-bold text-primario-black dark:text-neutral-200">
                          ${plan.precio}
                        </span>
                        <span class="text-lg font-bold text-primario-black dark:text-neutral-200">
                          .00
                        </span>
                        <span class="ms-3 text-primario-black dark:text-neutral-500">
                          USD
                        </span>
                      </div>

                      <div class="mt-5 grid gap-y-2 py-4 first:pt-0 last:pb-0 sm:gap-x-6 sm:gap-y-0">
                        <ul class="space-y-2 text-sm sm:text-base">
                          {plan.anadido && (
                            <li class="flex gap-x-3">
                              <span class="text-primario-black dark:text-neutral-200">
                                {plan.anadido}
                              </span>
                            </li>
                          )}
                          {plan.lista.map((li) => (
                            <li class="flex gap-x-3">
                              <span class="mt-0.5 flex size-5 items-center justify-center rounded-full bg-blue-50 text-secundario dark:bg-secundario/30 dark:text-secundario">
                                <Icon
                                  name={plan.icono}
                                  class="size-3.5 shrink-0 text-secundario dark:text-white"
                                />
                              </span>
                              <span class="text-primario-black dark:text-neutral-200">
                                {li}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <div class="mt-5 grid gap-x-4 py-4 first:pt-0 last:pb-0">
                        <div class="flex justify-end">
                          <a
                            href={plan.link}
                            class="inline-flex items-center gap-x-2 rounded-lg border border-gray-200 bg-secundario px-4 py-3 text-sm font-medium text-white shadow-2xs hover:bg-secundario/80 focus:bg-secundario/80 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-secundario dark:text-white dark:hover:bg-secundario/80 dark:focus:bg-secundario/80"
                          >
                            {plan.boton}
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                )
              )
            }
          </div>
          <!-- End Grid -->

          <!-- SVG Element -->
          <div
            class="absolute end-0 top-0 hidden translate-x-16 translate-y-16 md:block"
          >
            <svg
              class="h-auto w-16 text-[#00b8db]"
              width="121"
              height="135"
              viewBox="0 0 121 135"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M5 16.4754C11.7688 27.4499 21.2452 57.3224 5 89.0164"
                stroke="currentColor"
                stroke-width="10"
                stroke-linecap="round"></path>
              <path
                d="M33.6761 112.104C44.6984 98.1239 74.2618 57.6776 83.4821 5"
                stroke="currentColor"
                stroke-width="10"
                stroke-linecap="round"></path>
              <path
                d="M50.5525 130C68.2064 127.495 110.731 117.541 116 78.0874"
                stroke="currentColor"
                stroke-width="10"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <!-- End SVG Element -->

          <!-- SVG Element -->
          <div
            class="absolute start-0 bottom-0 hidden -translate-x-16 translate-y-16 md:block"
          >
            <svg
              class="h-auto w-56 text-orange-600"
              width="347"
              height="188"
              viewBox="0 0 347 188"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M4 82.4591C54.7956 92.8751 30.9771 162.782 68.2065 181.385C112.642 203.59 127.943 78.57 122.161 25.5053C120.504 2.2376 93.4028 -8.11128 89.7468 25.5053C85.8633 61.2125 130.186 199.678 180.982 146.248L214.898 107.02C224.322 95.4118 242.9 79.2851 258.6 107.02C274.299 134.754 299.315 125.589 309.861 117.539L343 93.4426"
                stroke="currentColor"
                stroke-width="7"
                stroke-linecap="round"></path>
            </svg>
          </div>
          <!-- End SVG Element -->
        </div>

        <div class="mt-7 text-center">
          <p class="text-xs text-gray-400">Precio en USD</p>
        </div>
      </div>
    </div>
    <!-- End Cards -->
  </section></MainLayout
>
