---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

import webdesing from "@images/web-servicios.avif";
import TechServices from "@images/tech-servicios.avif";
import líneasTelf from "@images/voice-servicios.png";
import stripeImg from "@images/stripe-servicios.png";

import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  
  {isRightSection: true,
    title: "Creación de agentes de IA",
    subTitle:
      "Aprovecha el poder de la tecnología para optimizar tus operaciones y potenciar tu negocio. Te ofrecemos soluciones tecnológicas a la medida, desde la creación de agentes de IA para automatizar procesos hasta el desarrollo de páginas web que establecen una presencia digital sólida.",
    single: true,
    imgOne: TechServices,
    imgOneAlt: "empresarios revisando computadora",
    btnExists: true,
    btnTitle: "Conocer más",
    btnURL: "/servicios-empresariales/creación-de-agentes-de-ia/"},
    {
    isRightSection: false,
    title: "Creación de páginas web",
    subTitle:
      "Tu presencia digital es la clave para conectar con tu audiencia. Te ofrecemos un servicio integral de creación de páginas web, diseñadas para proyectar una imagen profesional y sólida. ",
    img: webdesing,
    imgAlt:
      "Casa a escala con un contrato",
    btnExists: true,
    btnTitle: "Conocer más",
    btnURL: "/servicios-empresariales/paginas-web/",
  },
  {isRightSection: true,
    title: "Creación de líneas telefónicas internacionales.",
    subTitle:
      "Nuestro servicio de creación de líneas telefónicas internacionales con Google Voice te permite gestionar llamadas y mensajes de texto desde tu dispositivo actual, proyectando una presencia local en Estados Unidos sin la necesidad de un equipo físico o una residencia en el país.",
    single: true,
    imgOne: líneasTelf,
    imgOneAlt: "google voice",
    btnExists: true,
    btnTitle: "Conocer más",
    btnURL: "/servicios-profesionales/lineas-internacionales/"},
    {
    isRightSection: false,
    title: "Acompañamiento para solicitar y configurar Stripe",
    subTitle:
      "Te orientamos en la preparación de la solicitud y en la configuración técnica de Stripe. Stripe determina de forma independiente la disponibilidad, verificación y activación de cada cuenta.",
    img: stripeImg,
    imgAlt:
      "Imagen stripe",
    btnExists: true,
    btnTitle: "Conocer más",
    btnURL: "/servicios-profesionales/stripe-servicios/",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  "Uniting expertise with your vision, ScrewFast provides exceptional service and comprehensive solutions in the hardware and construction industry, from consultation to project completion.";
const ogTitle = "Expert Consultation Services | ScrewFast";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://sotomayorconsulting.com/servicios",
    url: "https://sotomayorconsulting.com/servicios",
    name: "Servicios | Sotomayor Consulting International",
    description:
      "Soluciones de consultoría estratégica y operativa adaptadas a sus necesidades. Sotomayor Consulting International ofrece experiencia en [Menciona 2-3 áreas clave: Ej. finanzas, procesos, tecnología].",
    
    isPartOf: {
      "@type": "WebSite",
      url: "https://sotomayorconsulting.com",
      name: "Sotomayor Consulting International",
      description:
        "Sotomayor Consulting International es su socio estratégico para el crecimiento empresarial y la optimización de procesos.",
    },
    inLanguage: "es-EC", 
  }}
>
  {/* MainSection is the introductory section of the page, it also contains a CTA button */}
  <MainSection
    label="Apoyando tu crecimiento"
    title="Soluciones óptimas integrales"
    description="Ayudamos a individuos, familias y empresas a identificar requisitos, preparar documentación y dar seguimiento a procesos locales e internacionales, sin sustituir a las autoridades ni garantizar sus decisiones."
    button="Contáctanos"
    label2="Mirar ahora"
  />
  
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="Nuestra Firma, Sus Resultados"
    subTitle="El compromiso de Sotomayor Consulting International con la excelencia y la confianza se refleja en cada uno de nuestros proyectos. Estamos dedicados a brindar servicios líderes en la industria que aseguran la protección y el crecimiento de su patrimonio a largo plazo"
    mainStatTitle="96%"
    mainStatSubTitle="de nuestros clientes califican su experiencia con Sotomayor Consulting International como excepcional."
    stats={[
      {
        stat: "99.8%",
        description: "Tasa de cumplimiento de objetivos",
      },
      {
        stat: "5,000+",
        description: "procesos de LLC acompañados en EE. UU.",
      },
      {
        stat: "85%",
        description: "de crecimiento en clientes, año tras año.",
      },
    ]}
  />
</MainLayout>
