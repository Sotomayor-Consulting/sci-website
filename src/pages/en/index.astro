---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSectionVideos from "@components/sections/landing/HeroSectionVideos.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import faqs from "@data/en/faqs.json";
import features from "@data/en/features.json";
import pricing from "@data/en/pricing.json";
import featureImage from "@images/home-image.jpg";
import CartasDeServiciosV2 from "@components/sections/landing/CartasDeServiciosV2.astro";
import GridServicios from "@/components/sections/features/GridServicios.astro";
import Banner from "@components/ui/banners/AnnouncementBanner.astro";
import RelayPartnerSection from "@components/sections/landing/RelayPartnerSection.astro";
import Evaluacion from "@components/sections/evaluacion/CallToActionEvaluacion.astro";
import Heroanimatev2 from "@components/sections/landing/Hero_animation_v2.astro";
---

<MainLayout>
  <Banner
    title="Sotomayor Consulting International is a consulting firm, not a bank. We do not provide loans, but we do provide all our support in the formation of your company, opening accounts, and technology solutions. We are not a government entity. We are here to advise you!"
    url="/"
    btnTitle="Learn more"
    btnId="xd"
  />

  <!-- <Heroanimate/> -->
  <Heroanimatev2
    title="We structure your global expansion with legal, tax, and technological precision."
    spam="Expand your business to the U.S."
    description="Sotomayor Consulting International is a boutique legal, tax, and technology consulting firm that helps clients (especially international ones) create companies in the U.S. and other jurisdictions, connect them to the financial system (banks/fintech), comply with taxes and accounting, and set up the digital infrastructure (AI, web, Stripe, telephony) needed to operate globally."
    Btnlabel="Start your LLC"
    slot="hero"
  />

  <!-- <HeroSectionVideos
    title=`360° Solutions for LLCs, Taxation, and Global Technology`
    subTitle="Sotomayor Consulting International is a boutique legal, tax, and technology consulting firm that helps clients (especially international ones) create companies in the U.S. and other jurisdictions, connect them to the financial system (banks/fintech), comply with taxes and accounting, and set up the digital infrastructure (AI, web, Stripe, telephony) needed to operate globally."
    primaryBtn="Start your LLC "
    primaryBtnURL="/#precios"
    secondaryBtn="Our Services"
    secondaryBtnURL="/#cartas-servicios"
    rating=`<span class="font-bold">4.8</span> / 5`
    starCount={4}
    reviews=`From Over <span class="font-bold">12.8k</span> Reviews`
    alt="Video of companies, people, and development"
    titleslide2="Your global expansion deserves a structure, not just a procedure."
    descriptionslide2="We are the strategic partner that protects your assets with rigor and expert support, ensuring your entry into the world is solid, correct, and, above all, definitive."
    dabgeslide3="We provide clarity and security"
    tituloslide3="Your vision in a solid and strategic legal architecture."
    descriptionslide3="At Sotomayor Consulting International, we design the exact structure your assets need to expand successfully. We are architects of your legal and tax security in the United States and the world."
    button1slide3="Free Diagnostic"
    button2slide3="Schedule a meeting"
  /> -->

  <RelayPartnerSection />

  <CartasDeServiciosV2
    title="Everything for your Company"
    subTitle="We offer personalized service solutions for professionals, individuals, families, and companies, addressing their specific needs."
  />

  <FeaturesGeneral
    title="Discover our app"
    subTitle="Organize your LLC and your company in one place, with support from our team."
    src={featureImage}
    alt="ScrewFast products in floating boxes"
    features={features}
  />

  <GridServicios
    title="Star product"
    description="We support global entrepreneurs in the formation of their company in the U.S., tax design, documentary assistance advisory for banking onboarding with third parties, and legal compliance advisory from anywhere in the world."
    link="#precios"
    grid2="Countries"
    grid3="Explore our services"
    grid3link="/services"
    grid4="Contact us"
    grid4link="/contact"
  />

  <TestimonialsSection
    title="Boost your Projects"
    subTitle="At Sotomayor Consulting International, we guarantee an agile start with constant support. Experience the redefinition of advisory."
    ;
    testimonials={[
      {
        content:
          "Sotomayor Consulting International gave me a clear solution for my LLC. The process was straightforward and the support helped me and advised me on setting up and enabling payments with third-party payment processors (e.g., Stripe/PayPal). I recommend the service.",
        author: "Diego Morales",
        role: "E-commerce entrepreneur",
        avatarSrc:
          "https://images.unsplash.com/photo-1624561172888-ac93c696e10c?q=80&w=389&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
      },
    ]}
    statistics={[
      {
        count: "5,000",
        description: "Companies supported",
      },
      {
        count: "1,354",
        description: "Projects completed",
      },
      {
        count: "97%",
        description: "Satisfaction",
      },
      {
        count: "10",
        description: "Years of Experience",
      },
    ]}
  />

  <Evaluacion
    title="Find out if an LLC is really the best structure for you."
    button="Take the free diagnostic"
  >
    Avoid legal and tax mistakes that can cost you thousands of dollars.
    <b>In just 2 minutes, our free diagnostic</b> analyzes your specific situation
    and clearly tells you whether an LLC in the U.S. is the right option for
    your case or if there is a better alternative.
  </Evaluacion>

  <PricingSection pricing={pricing} />

  <FAQ title="Frequently<br />Asked Questions" faqs={faqs} />

  <HeroSectionAlt
    title="Let's Work Together"
    subTitle="SCI is a specialized comprehensive service, meticulously designed with global solutions in company formation, tax planning, immigration services, and international real estate."
    url="/contact"
    btnTitle="Contact us"
  />
</MainLayout>
