---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

import webdesing from "@images/web-servicios.avif";
import TechServices from "@images/tech-servicios.avif";
import líneasTelf from "@images/voice-servicios.png";
import stripeImg from "@images/stripe-servicios.png";

import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "AI Agent Creation",
    subTitle:
      "Leverage the power of technology to optimize your operations and boost your business. We offer tailored technological solutions, from creating AI agents to automate processes to developing websites that establish a solid digital presence.",
    single: true,
    imgOne: TechServices,
    imgOneAlt: "business people reviewing computer",
    btnExists: true,
    btnTitle: "Learn more",
    btnURL: "/en/servicios-empresariales/creación-de-agentes-de-ia/",
  },
  {
    isRightSection: false,
    title: "Website Development",
    subTitle:
      "Your digital presence is the key to connecting with your audience. We offer a comprehensive website development service, designed to project a professional and solid image.",
    img: webdesing,
    imgAlt: "House scale with a contract",
    btnExists: true,
    btnTitle: "Learn more",
    btnURL: "/en/servicios-empresariales/paginas-web/",
  },
  {
    isRightSection: true,
    title: "International Phone Lines Creation",
    subTitle:
      "Our international phone line creation service with Google Voice allows you to manage calls and text messages from your current device, projecting a local presence in the United States without the need for physical equipment or residence in the country.",
    single: true,
    imgOne: líneasTelf,
    imgOneAlt: "google voice",
    btnExists: true,
    btnTitle: "Learn more",
    btnURL: "/en/servicios-profesionales/lineas-internacionales/",
  },
  {
    isRightSection: false,
    title: "Guidance to Apply for and Configure Stripe",
    subTitle:
      "We guide you in preparing the application and technically configuring Stripe. Stripe independently determines account availability, verification, and activation.",
    img: stripeImg,
    imgAlt: "Stripe image",
    btnExists: true,
    btnTitle: "Learn more",
    btnURL: "/en/servicios-profesionales/stripe-servicios/",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  "Strategic and operational consulting solutions tailored to your needs. Sotomayor Consulting International offers expertise in business formation, digital services, and international business solutions.";
const ogTitle = "Services | Sotomayor Consulting International";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://sotomayorconsulting.com/en/services",
    url: "https://sotomayorconsulting.com/en/services",
    name: "Services | Sotomayor Consulting International",
    description:
      "Strategic and operational consulting solutions tailored to your needs. Sotomayor Consulting International offers expertise in business formation, digital services, and international business solutions.",

    isPartOf: {
      "@type": "WebSite",
      url: "https://sotomayorconsulting.com/en",
      name: "Sotomayor Consulting International",
      description:
        "Sotomayor Consulting International is your strategic partner for business growth and process optimization.",
    },
    inLanguage: "en-US",
  }}
>
  {
    /* MainSection is the introductory section of the page, it also contains a CTA button */
  }
  <MainSection
    label="Supporting your growth"
    title="Optimal comprehensive solutions"
    description="We help individuals, families, and businesses identify requirements, prepare documents, and follow local and international processes without replacing authorities or guaranteeing their decisions."
    button="Contact us"
    label2="Watch now"
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="Our Firm, Your Results"
    subTitle="Sotomayor Consulting International's commitment to excellence and trust is reflected in every project. We are dedicated to providing industry-leading services that ensure the protection and growth of your assets for the long term."
    mainStatTitle="96%"
    mainStatSubTitle="of our clients rate their experience with Sotomayor Consulting International as exceptional."
    stats={[
      {
        stat: "99.8%",
        description: "Goal achievement rate",
      },
      {
        stat: "5,000+",
        description: "U.S. LLC processes supported",
      },
      {
        stat: "85%",
        description: "Client growth year over year.",
      },
    ]}
  />
</MainLayout>
